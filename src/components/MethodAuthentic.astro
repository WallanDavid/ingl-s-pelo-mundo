---
// src/components/MethodAuthentic.astro
// Os Métodos da Prof. Amanda Beatriz: Os 4Ps e A.U.T.E.N.T.I.C.A
---

<section id="metodo" class="py-20 lg:py-28 bg-[#05050a] relative overflow-hidden">
  
  <!-- Subtle cosmic background -->
  <div class="absolute top-1/3 right-1/4 w-[600px] h-[500px] bg-[radial-gradient(ellipse,rgba(155,143,255,0.09)_0%,transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Cabeçalho -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff] mb-4">
        <span>Estação 2 · A Metodologia Autêntica</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-white tracking-tight leading-tight">
        Como a neurociência destrava o inglês que <em class="italic font-normal text-[#c8c2ff]">mora em você.</em>
      </h2>
      <p class="mt-4 text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
        Não existe 'dom para idiomas'. Existe alinhamento entre o que a ciência sabe sobre o cérebro e a forma como você estuda no dia a dia.
      </p>
    </div>

    <!-- PARTE 1: OS 4Ps DA PRONÚNCIA EM BLOCOS VISUAIS -->
    <div class="mb-20">
      <div class="text-center mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-[#9b8fff]">Fundamento Fonético</span>
        <h3 class="text-2xl sm:text-3xl font-serif text-white mt-1">Os 4Ps da Fala Espontânea</h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- P1: Padrões -->
        <div class="glass-card p-6 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-[#9b8fff]/10 border border-[#9b8fff]/30 flex items-center justify-center text-[#c8c2ff] group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
              </svg>
            </div>
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#9b8fff]">1º Pilar</span>
              <h4 class="text-lg font-bold text-white mt-0.5">Padrões de Fala</h4>
              <p class="text-xs text-slate-300 mt-2 leading-relaxed">
                Nativos não falam palavras isoladas. Eles usam blocos conectados (chunks). Você aprende o ritmo natural antes da gramática formal.
              </p>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-white/5 text-[11px] font-semibold text-slate-400">
            Ex: "Whadya do?" em vez de regras rígidas
          </div>
        </div>

        <!-- P2: Pronúncia -->
        <div class="glass-card p-6 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
              </svg>
            </div>
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">2º Pilar</span>
              <h4 class="text-lg font-bold text-white mt-0.5">Pronúncia Descomplicada</h4>
              <p class="text-xs text-slate-300 mt-2 leading-relaxed">
                Ajuste da posição da língua e respiração para os sons que não existem no português, sem jargões fonéticos impenetráveis.
              </p>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-white/5 text-[11px] font-semibold text-slate-400">
            Foco em clareza, não em sotaque forçado
          </div>
        </div>

        <!-- P3: Psicológico -->
        <div class="glass-card p-6 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-300 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-amber-300">3º Pilar</span>
              <h4 class="text-lg font-bold text-white mt-0.5">Psicológico & Coragem</h4>
              <p class="text-xs text-slate-300 mt-2 leading-relaxed">
                Desarmamos o medo de ser julgado e a vergonha de errar. Falar outro idioma é uma habilidade de comunicação, não um teste de vestibular.
              </p>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-white/5 text-[11px] font-semibold text-slate-400">
            Ambiente 100% seguro para destravar
          </div>
        </div>

        <!-- P4: Prática -->
        <div class="glass-card p-6 flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-[#6c5fff]/10 border border-[#6c5fff]/30 flex items-center justify-center text-[#c8c2ff] group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#9b8fff]">4º Pilar</span>
              <h4 class="text-lg font-bold text-white mt-0.5">Prática Viva Semanal</h4>
              <p class="text-xs text-slate-300 mt-2 leading-relaxed">
                Toda quarta-feira ao vivo com a Prof. Amanda Beatriz. Conversação guiada sobre viagens, negócios e rotina para colocar tudo em ação.
              </p>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-white/5 text-[11px] font-semibold text-slate-400">
            Mentorias ao vivo com tira-dúvidas
          </div>
        </div>

      </div>
    </div>

    <!-- PARTE 2: A MATRIZ A.U.T.E.N.T.I.C.A INTERATIVA -->
    <div class="p-6 sm:p-10 rounded-3xl bg-[#0c0d1a] border border-white/10 shadow-2xl mb-20">
      
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-white/10 pb-6 mb-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#9b8fff]">A Matriz Pedagógica</span>
          <h3 class="text-2xl sm:text-3xl font-serif text-white">Método A.U.T.E.N.T.I.C.A em Ação</h3>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Clique em cada letra para ver como os 9 princípios guiam sua aprendizagem:
          </p>
        </div>
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 bg-white/5 px-3 py-1.5 rounded-full border border-white/10 shrink-0">
          9 Pilares Estruturados
        </div>
      </div>

      <!-- Letras Interativas (A - U - T - E - N - T - I - C - A) -->
      <div class="flex flex-wrap gap-2 sm:gap-3 justify-center mb-8" id="autentica-letters">
        {['A', 'U', 'T', 'E', 'N', 'T2', 'I', 'C', 'A2'].map((key, index) => {
          const letterChar = key.replace('2', '');
          const isFirst = index === 0;
          return (
            <button
              type="button"
              data-pillar={key}
              class={`pillar-btn ${isFirst ? 'active bg-white text-black font-black' : 'bg-white/5 text-slate-300'} w-11 h-11 sm:w-14 sm:h-14 rounded-2xl border border-white/10 flex items-center justify-center text-lg sm:text-xl font-serif transition-all hover:scale-105`}
            >
              {letterChar}
            </button>
          );
        })}
      </div>

      <!-- Painel Dinâmico do Pilar Selecionado -->
      <div id="pillar-card-display" class="p-6 sm:p-8 rounded-2xl bg-[#13152a] border border-white/15 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold uppercase text-[#c8c2ff]" id="pillar-badge">
            A — Assimilação & Aculturamento
          </div>
          <h4 class="text-xl sm:text-2xl font-bold text-white" id="pillar-title">
            Integração cultural e linguística real
          </h4>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed" id="pillar-description">
            Você não aprende apenas o vocabulário: aprende o contexto social, o humor, os gestos e as referências culturais que fazem o idioma soar natural em qualquer país do mundo.
          </p>
        </div>
        <div class="shrink-0 p-4 rounded-xl bg-white/5 border border-white/10 text-center w-full md:w-auto">
          <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Benefício Direto</span>
          <span class="text-xs font-extrabold text-emerald-400 block mt-1" id="pillar-benefit">
            Sem passar vergonha no exterior
          </span>
        </div>
      </div>

    </div>

    <!-- PARTE 3: QUEM É A PROF. AMANDA BEATRIZ -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Galeria Real de Amanda Beatriz -->
      <div class="lg:col-span-5 relative">
        <div class="rounded-3xl overflow-hidden border border-white/15 shadow-2xl bg-[#0c0d1a] relative group">
          <img 
            src="/images/class-live.jpeg" 
            alt="Prof. Amanda Beatriz em aula ao vivo" 
            class="w-full h-80 sm:h-96 object-cover object-top transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#05050a] via-transparent to-transparent opacity-70"></div>
          
          <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-[#05050a]/90 backdrop-blur border border-white/10">
            <span class="text-xs font-serif font-bold text-white block">Amanda Beatriz</span>
            <span class="text-[11px] text-[#c8c2ff] block mt-0.5">+10.000 aulas dadas · Hiperpoliglota em Construção</span>
          </div>
        </div>
      </div>

      <!-- História e Autoridade -->
      <div class="lg:col-span-7 space-y-5 text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff]">
          <span>Sua Mentora</span>
        </div>
        
        <h3 class="text-3xl sm:text-4xl font-serif text-white tracking-tight leading-tight">
          "Eu me recusei a aceitar que as pessoas passassem anos <em class="italic text-[#c8c2ff]">achando que o problema eram elas."</em>
        </h3>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans">
          Amanda Beatriz é professora poliglota de idiomas há mais de 5 anos, criadora da Metodologia Autêntica e fundadora do movimento Fluente no Mundo. Com formação internacional e estudos em neurociência e psicologia da aprendizagem, desenvolveu um método que já transformou milhares de pessoas dentro e fora do Brasil.
        </p>

        <!-- Fatos sobre mim (Em formato de cartões limpos) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/10">
            <span class="text-xl">🎵</span>
            <div class="text-xs font-bold text-white mt-1">Música & Idiomas</div>
            <p class="text-[11px] text-slate-400 mt-0.5 leading-snug">Ouvido musical aplicado à assimilação fonética rápida.</p>
          </div>

          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/10">
            <span class="text-xl">🧠</span>
            <div class="text-xs font-bold text-white mt-1">Neurodivergência</div>
            <p class="text-[11px] text-slate-400 mt-0.5 leading-snug">Ensino acolhedor, dinâmico e sem sobrecarga sensorial.</p>
          </div>

          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/10">
            <span class="text-xl">🌍</span>
            <div class="text-xs font-bold text-white mt-1">Hiperpoliglota</div>
            <p class="text-[11px] text-slate-400 mt-0.5 leading-snug">Mais de 10 anos de estudo diário e múltiplos idiomas.</p>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="#planos"
            class="btn-white-luxury inline-flex items-center gap-2 px-7 py-3.5 text-xs uppercase tracking-wider"
          >
            <span>Estudar com a Prof. Amanda</span>
            <svg class="w-3.5 h-3.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Dados dos 9 Pilares A.U.T.E.N.T.I.C.A
  const pillarsData: Record<string, { badge: string; title: string; desc: string; benefit: string }> = {
    A: {
      badge: 'A — Assimilação & Aculturamento',
      title: 'Integração cultural e linguística real',
      desc: 'Você não aprende apenas palavras soltas: aprende o contexto social, o humor, os gestos e as referências culturais que fazem o idioma soar natural em qualquer país.',
      benefit: 'Sem passar vergonha no exterior'
    },
    U: {
      badge: 'U — União, Equilíbrio & Constância',
      title: 'Unir fundamentos com equilíbrio sem queimar a largada',
      desc: 'Nada de maratonar 5 horas no sábado e sumir a semana toda. O método equilibra 20 minutos diários sustentáveis que constroem a verdadeira fluência.',
      benefit: 'Constância sem cansaço mental'
    },
    T: {
      badge: 'T — Treine os 4Ps',
      title: 'Padrões · Pronúncia · Psicológico · Prática',
      desc: 'O quarteto essencial que faz a fala fluir naturalmente, treinando os sons antes de decorar regras gramaticais estáticas.',
      benefit: 'Destrave fonético em 90 dias'
    },
    E: {
      badge: 'E — Emoções & Confiança',
      title: 'Aprendizagem com segurança emocional',
      desc: 'O estresse bloqueia a aquisição de linguagem (Filtro Afetivo de Krashen). Criamos um ambiente onde você se sente acolhido e seguro para falar sem medo.',
      benefit: 'Fim da vergonha de falar em público'
    },
    N: {
      badge: 'N — Neurociência 4D',
      title: 'Neurociência aplicada ao aprendizado e performance',
      desc: 'Técnicas de plasticidade cerebral, dopamina e ritmo circadiano para maximizar a retenção e diminuir o esforço cognitivo.',
      benefit: 'Memorização acelerada sem decoreba'
    },
    T2: {
      badge: 'T — Metacognição (Aprender a Aprender)',
      title: 'Técnicas de estudo inteligente e autonomia',
      desc: 'Você descobre como o seu próprio cérebro aprende melhor (visual, auditivo ou cinestésico) e ganha independência para estudar qualquer idioma.',
      benefit: 'Autonomia para a vida toda'
    },
    I: {
      badge: 'I — Input Massivo & Imersão',
      title: 'Grande exposição ao idioma através das aulas e prática',
      desc: 'Aulas em áudio nativo, séries comentadas, podcasts e músicas para alimentar o seu cérebro com o inglês real do mundo contemporâneo.',
      benefit: 'Compreensão de nativos rápidos'
    },
    C: {
      badge: 'C — Conexões Autênticas',
      title: 'Conectar estudo com prática real e consolidação',
      desc: 'Exercícios práticos de aplicação direta: emails corporativos, conversas de restaurante, check-in em hotéis e apresentações.',
      benefit: 'Uso prático no trabalho e viagens'
    },
    A2: {
      badge: 'A — Aquisição 3R',
      title: 'Revisão · Repetição · Reapresentação (SRS)',
      desc: 'Sistema de repetição espaçada inteligente com áudio em 3 etapas para transferir o vocabulário para a memória permanente.',
      benefit: 'Você nunca mais esquece as palavras'
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const letterButtons = document.querySelectorAll('.pillar-btn');
    const badgeEl = document.getElementById('pillar-badge');
    const titleEl = document.getElementById('pillar-title');
    const descEl = document.getElementById('pillar-description');
    const benefitEl = document.getElementById('pillar-benefit');

    letterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pillarKey = btn.getAttribute('data-pillar');
        if (!pillarKey || !pillarsData[pillarKey]) return;

        letterButtons.forEach((b) => {
          b.classList.remove('active', 'bg-white', 'text-black', 'font-black');
          b.classList.add('bg-white/5', 'text-slate-300');
        });

        btn.classList.add('active', 'bg-white', 'text-black', 'font-black');
        btn.classList.remove('bg-white/5', 'text-slate-300');

        if (badgeEl) badgeEl.textContent = pillarsData[pillarKey].badge;
        if (titleEl) titleEl.textContent = pillarsData[pillarKey].title;
        if (descEl) descEl.textContent = pillarsData[pillarKey].desc;
        if (benefitEl) benefitEl.textContent = pillarsData[pillarKey].benefit;
      });
    });
  });
</script>
