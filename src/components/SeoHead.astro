---
export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  structuredData?: any;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImage = '/images/cafe-com-plataforma.jpg',
  structuredData,
} = Astro.props;

const siteUrl = 'https://fluentenomundo.com';
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Base Schema.org EducationalOrganization
const defaultOrgSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  'name': 'Fluente no Mundo',
  'url': siteUrl,
  'logo': `${siteUrl}/images/logo-white.png`,
  'description': 'Escola e ecossistema de aprendizagem de idiomas fundado pela Prof. Amanda Beatriz, baseado na Metodologia Autêntica e aulas ao vivo.',
  'founder': {
    '@type': 'Person',
    'name': 'Amanda Beatriz',
    'jobTitle': 'Professora e Fundadora',
  },
  'sameAs': [
    'https://www.youtube.com/@fluentenomundo',
    'https://instagram.com/fluentenomundo',
  ],
};

const finalStructuredData = structuredData || defaultOrgSchema;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0a0e1a" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="curso de ingles online, fluente no mundo, amanda beatriz, metodologia autentica, ingles descomplicado, aulas ao vivo ingles, repeticao espacada ingles, srs vocabulario, falar ingles sem medo" />
<meta name="author" content="Amanda Beatriz | Fluente no Mundo" />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Fluente no Mundo" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullOgImage} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(finalStructuredData)} />
