  document.addEventListener('DOMContentLoaded', () => {
    const navButtons = document.querySelectorAll('.module-nav-btn');
    const titleEl = document.getElementById('detail-title');
    const iconEl = document.getElementById('detail-icon');
    const badgeEl = document.getElementById('detail-badge');
    const descEl = document.getElementById('detail-desc');
    const pTypeEl = document.getElementById('preview-type');
    const pMetaEl = document.getElementById('preview-meta');
    const f1El = document.getElementById('feat-1');
    const f2El = document.getElementById('feat-2');
    const f3El = document.getElementById('feat-3');
    const f4El = document.getElementById('feat-4');

    navButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-mod-id');
        if (!id || !detailsData[id]) return;

        navButtons.forEach((b) => {
          b.classList.remove('active', 'bg-white/10', 'text-white', 'border-white/20');
          b.classList.add('text-slate-400', 'border-transparent');
        });

        btn.classList.add('active', 'bg-white/10', 'text-white', 'border-white/20');
        btn.classList.remove('text-slate-400', 'border-transparent');

        const d = detailsData[id];
        if (titleEl) titleEl.textContent = d.title;
        if (iconEl) iconEl.textContent = d.icon;
        if (badgeEl) badgeEl.textContent = d.badge;
        if (descEl) descEl.textContent = d.desc;
        if (pTypeEl) pTypeEl.textContent = d.previewType;
        if (pMetaEl) pMetaEl.textContent = d.previewMeta;
        if (f1El) f1El.textContent = d.f1;
        if (f2El) f2El.textContent = d.f2;
        if (f3El) f3El.textContent = d.f3;
        if (f4El) f4El.textContent = d.f4;
      });
    });
  });
</script>
