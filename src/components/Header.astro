---
// src/components/Header.astro
// Navegação Oficial Premium — Fluente no Mundo
const navItems = [
  { label: 'A Viagem', href: '/#viagem' },
  { label: 'Método A.U.T.E.N.T.I.C.A', href: '/#metodo' },
  { label: '15 Produtos', href: '/#produtos' },
  { label: 'Comparativo', href: '/#comparativo' },
  { label: 'Planos', href: '/#planos' },
  { label: 'Dúvidas', href: '/#faq' },
];
---

<header class="sticky top-0 z-50 w-full bg-[#05050a]/90 backdrop-blur-xl border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Oficial com Ícone Original -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-[#9b8fff] rounded-lg p-1" aria-label="Fluente no Mundo - Início">
        <div class="relative w-11 h-11 flex items-center justify-center rounded-xl bg-white/[0.04] border border-white/15 group-hover:border-[#9b8fff]/50 transition-colors overflow-hidden">
          <img 
            src="/images/logo-white.png" 
            alt="Fluente no Mundo" 
            class="w-8 h-8 object-contain transition-transform group-hover:scale-110"
            width="32" 
            height="32"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-black text-lg sm:text-xl tracking-tight text-white group-hover:text-[#c8c2ff] transition-colors leading-none">
            Fluente no Mundo
          </span>
          <span class="text-[11px] uppercase tracking-widest text-slate-400 font-medium mt-1">
            Prof. Amanda Beatriz
          </span>
        </div>
      </a>

      <!-- Navegação Desktop -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegação Principal">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 rounded-full transition-all"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Ações do Header: Área do Aluno + CTA Embarque -->
      <div class="hidden lg:flex items-center gap-3">
        <!-- Link Oficial para Plataforma de Alunos -->
        <a
          href="https://alunos.fluentenomundo.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-semibold tracking-wide text-white bg-white/5 hover:bg-white/10 border border-white/15 hover:border-[#9b8fff]/40 transition-all group"
          title="Acessar Área do Aluno Fluente no Mundo"
          id="btn-link-alunos-desktop"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 group-hover:animate-ping"></span>
          <span>Área do Aluno</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <!-- Botão Primário de Conversão -->
        <a
          href="#planos"
          class="btn-white-luxury inline-flex items-center gap-2 px-5 py-2.5 text-xs uppercase tracking-wider shadow-lg"
          id="btn-cta-header-desktop"
        >
          <span>Embarcar</span>
          <svg class="w-3.5 h-3.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Botões Mobile -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href="https://alunos.fluentenomundo.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 text-[11px] font-bold text-slate-200 bg-white/5 border border-white/10 rounded-full"
        >
          Alunos
        </a>
        <a
          href="#planos"
          class="px-3.5 py-1.5 text-[11px] font-bold text-black bg-white rounded-full shadow-sm"
        >
          Planos
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-[#9b8fff]"
          aria-label="Abrir Menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Drawer Menu Mobile -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-white/10 bg-[#070812]/98 backdrop-blur-2xl px-6 pt-4 pb-8 space-y-4">
    <div class="flex flex-col gap-1.5">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link px-4 py-3 rounded-xl text-sm font-semibold text-slate-200 hover:text-white hover:bg-white/5 transition-all flex items-center justify-between"
        >
          <span>{item.label}</span>
          <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </div>
    
    <div class="pt-4 border-t border-white/10 flex flex-col gap-3">
      <a
        href="https://alunos.fluentenomundo.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 text-xs font-bold uppercase tracking-wider text-white bg-white/10 border border-white/15 rounded-xl hover:bg-white/15 transition-all"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Acessar Plataforma do Aluno</span>
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <a
        href="#planos"
        class="mobile-nav-link w-full flex items-center justify-center gap-2 py-3.5 text-xs font-bold uppercase tracking-wider text-black bg-white rounded-xl shadow-lg hover:bg-slate-100 transition-all"
      >
        <span>Garantir Matrícula (R$ 39,90)</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu(show?: boolean) {
    if (!mobileMenu || !iconOpen || !iconClose || !menuBtn) return;
    const isHidden = mobileMenu.classList.contains('hidden');
    const targetState = show !== undefined ? show : isHidden;

    if (targetState) {
      mobileMenu.classList.remove('hidden');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      menuBtn.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
    }
  }

  if (menuBtn) {
    menuBtn.addEventListener('click', () => toggleMenu());
  }

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => toggleMenu(false));
  });
</script>
