---

<section id="produtos" class="py-24 bg-[#07080e] relative overflow-hidden border-t border-b border-white/5">
  <!-- Subtle ambient glow inspired by fluentenomundo.com -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-[radial-gradient(ellipse,rgba(155,143,255,0.08)_0%,transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold uppercase tracking-widest text-[#9b8fff] mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
        O Ecossistema Completo Fluente no Mundo
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-white tracking-tight leading-tight">
        Conheça os <em class="italic font-normal text-[#c8c2ff]">15 Produtos & Módulos</em> que Você Recebe ao Entrar
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed font-sans">
        Ao se matricular no Fluente no Mundo, você não adquire apenas um curso de regras gramaticais: você desbloqueia uma escola viva com 15 frentes de aprendizado, materiais e acompanhamento.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap justify-center gap-2 mt-8" id="product-filters">
        <button type="button" data-filter="all" class="filter-btn active px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all bg-white text-slate-950 shadow-lg">
          Todos os 15 Módulos
        </button>
        <button type="button" data-filter="core" class="filter-btn px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all bg-white/5 text-slate-300 hover:bg-white/10 border border-white/10">
          Núcleo Central
        </button>
        <button type="button" data-filter="practice" class="filter-btn px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all bg-white/5 text-slate-300 hover:bg-white/10 border border-white/10">
          Prática & Vivência
        </button>
        <button type="button" data-filter="resources" class="filter-btn px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all bg-white/5 text-slate-300 hover:bg-white/10 border border-white/10">
          Recursos & Materiais
        </button>
        <button type="button" data-filter="community" class="filter-btn px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all bg-white/5 text-slate-300 hover:bg-white/10 border border-white/10">
          Tribo & Comunidade
        </button>
      </div>
    </div>

    <!-- Product Showcase Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="products-grid">
      {products.map((item) => (
        <article 
          class="product-card group bg-[#0e101a] border border-white/10 hover:border-[#9b8fff]/40 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#6c5fff]/10 flex flex-col justify-between"
          data-category={item.category}
          id={`item-${item.id}`}
        >
          <!-- Card Header & Image -->
          <div>
            {item.realImage && (
              <div class="relative h-48 w-full overflow-hidden bg-slate-900 border-b border-white/10">
                <img 
                  src={item.realImage} 
                  alt={item.name} 
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0e101a] via-transparent to-transparent opacity-80"></div>
                <div class="absolute top-3 left-3">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-950/80 backdrop-blur border border-white/10 text-white">
                    {item.badge}
                  </span>
                </div>
                <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-950/80 backdrop-blur border border-white/10 flex items-center justify-center text-[#9b8fff]">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={item.iconSvg} />
                </div>
              </div>
            )}

            {!item.realImage && (
              <div class="p-6 pb-0 flex items-center justify-between">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/5 border border-white/10 text-slate-300">
                  {item.badge}
                </span>
                <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-[#9b8fff]">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={item.iconSvg} />
