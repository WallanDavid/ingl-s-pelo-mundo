---
// src/components/ProductsCatalog.astro
// Apresenta com clareza comercial os 15 produtos e módulos reais da plataforma Fluente no Mundo

interface ProductItem {
  id: string;
  name: string;
  category: 'core' | 'practice' | 'resources' | 'community';
  categoryLabel: string;
  badge: string;
  summary: string;
  description: string;
  features: string[];
  realImage?: string;
  iconSvg: string;
}

const products: ProductItem[] = [
  {
    id: 'formacao-global',
    name: 'Formação Global',
    category: 'core',
    categoryLabel: 'Núcleo Central',
    badge: 'Curso Principal',
    summary: 'A espinha dorsal da sua jornada, do nível básico até a segurança avançada.',
    description: 'Trilha curricular estruturada que cobre desde a fundação dos sons e padrões da fala até a comunicação complexa em reuniões de negócios, negociações globais, viagens internacionais e apresentações de alto impacto.',
    features: [
      'Trilhas passo a passo para iniciantes e intermediários',
      'Foco direto em Business English e conversação do mundo real',
      'Exercícios de aplicação prática imediata sem listas infinitas de gramática',
      'Certificados de conclusão ao final de cada marco da formação'
    ],
    realImage: '/images/original/bizz class (1).jpeg',
    iconSvg: `<path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14v7"/>`
  },
  {
    id: 'autentica',
    name: 'Método A.U.T.E.N.T.I.C.A',
    category: 'core',
    categoryLabel: 'Núcleo Central',
    badge: 'Metodologia Própria',
    summary: 'Os 9 pilares da neuroaprendizagem para falar sem traduzir mentalmente.',
    description: 'Desenvolvido pela Prof. Amanda Beatriz após mais de 10.000 aulas, o método A.U.T.E.N.T.I.C.A reprograma a sua relação com a fala eliminando o bloqueio emocional, a síndrome da tradução literal e o medo de cometer erros em público.',
    features: [
      'Aquisição natural de estruturas através de contextos reais',
      'Desbloqueio da fala espontânea com técnicas fonéticas descomplicadas',
      'Treino do ouvido para entender sotaques de diferentes partes do mundo',
      'Consistência sustentável sem sobrecarga mental'
    ],
    realImage: '/images/platform/autentica.png',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>`
  },
  {
    id: 'jornada-poliglota',
    name: 'Jornada Poliglota',
    category: 'core',
    categoryLabel: 'Núcleo Central',
    badge: '12 Idiomas Inclusos',
    summary: 'Aprenda múltiplos idiomas com o mesmo método e a mesma assinatura.',
    description: 'Você não fica restrito ao inglês. Tenha acesso a trilhas de aceleração para Espanhol, Francês, Italiano, Alemão e outros idiomas, aproveitando conexões cognitivas e transferências linguísticas naturais.',
    features: [
      'Inglês, Espanhol, Italiano, Francês, Alemão e mais',
      'Matrizes de comparação lexical para aprender mais rápido',
      'Módulos práticos para viagens e vivências internacionais',
      'Incluso sem mensalidades adicionais em todos os planos'
