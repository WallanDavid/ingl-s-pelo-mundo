---
const pillars = [
  {
    letter: 'A',
    name: 'Assimilação e Aculturamento',
    subtitle: 'Integração cultural e linguística profunda',
    desc: 'O idioma não é uma lista de regras isoladas, mas a expressão viva de uma cultura. Você aprende a pensar e sentir no contexto real de nativos.',
    tag: 'Fundamento Cultural',
    color: 'from-blue-500 to-indigo-600',
  },
  {
    letter: 'U',
    name: 'União, Equilíbrio e Constância',
    subtitle: 'Harmonia entre gramática, escuta e fala',
    desc: 'Sem sobrecargas desnecessárias. Unimos todos os fundamentos com doses diárias sustentáveis que cabem na sua rotina real.',
    tag: 'Rotina Sustentável',
    color: 'from-indigo-500 to-purple-600',
  },
  {
    letter: 'T',
    name: 'Treine os 4P',
    subtitle: 'Padrões · Pronúncia · Psicológico · Prática',
    desc: 'O treinamento focado para destravar a musculatura vocal, vencer a autocrítica paralisante e reconhecer padrões sonoros sem esforço.',
    tag: 'Treinamento 4P',
    color: 'from-purple-500 to-pink-600',
  },
  {
    letter: 'E',
    name: 'Emoções',
    subtitle: 'Aprendizagem com segurança e confiança',
    desc: 'A neurociência comprova: o cérebro bloqueia memórias sob ansiedade e medo de errar. Criamos um ambiente emocional seguro para você se expressar livremente.',
    tag: 'Segurança Emocional',
    color: 'from-pink-500 to-rose-600',
  },
  {
    letter: 'N',
    name: 'Neurociência 4D',
    subtitle: 'Cognição aplicada ao aprendizado acelerado',
    desc: 'Técnicas baseadas em sinapses ativas, neuroplasticidade e retenção de longo prazo para que o vocabulário permaneça gravado de verdade.',
    tag: 'Neurocognição',
    color: 'from-amber-500 to-orange-600',
  },
  {
    letter: 'T',
    name: 'Técnicas de Metacognição',
    subtitle: 'Aprender a aprender com autonomia',
    desc: 'Você desenvolve a habilidade de diagnosticar seus próprios pontos cegos e dominar estratégias de estudo eficientes pelo resto da vida.',
    tag: 'Metacognição',
    color: 'from-yellow-500 to-amber-600',
  },
  {
    letter: 'I',
    name: 'Input Massivo e Imersão',
    subtitle: 'Exposição guiada a conteúdos autênticos',
    desc: 'Imersão contextual com podcasts, filmes e masterclasses ao vivo, alimentando seu ouvido antes de exigir uma fala forçada.',
    tag: 'Imersão Ativa',
    color: 'from-teal-500 to-emerald-600',
  },
  {
    letter: 'C',
    name: 'Conexões Autênticas',
    subtitle: 'Conectar o estudo à vida real',
    desc: 'Você não decora frases prontas de livro. Aplica o vocabulário à sua profissão, seus gostos, suas conversas reais e viagens.',
    tag: 'Comunicação Real',
    color: 'from-cyan-500 to-blue-600',
  },
  {
    letter: 'A',
    name: 'Aquisição 3R',
    subtitle: 'Revisão · Repetição · Reapresentação',
    desc: 'O ciclo definitivo de consolidação da memória: revisões em intervalos inteligentes e reapresentação em múltiplos formatos para fixação total.',
    tag: 'Ciclo 3R',
    color: 'from-blue-600 to-indigo-700',
  },
];
---

<section id="metodo-autentico" class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabeçalho da Seção -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>✨ Metodologia Exclusiva</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white tracking-tight leading-tight">
        O Método <span class="gradient-text-indigo">A.U.T.E.N.T.I.C.A</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Esqueça métodos que tratam você como um robô repetidor de regras gramaticais. Os 9 pilares foram desenhados para reprogramar sua relação com o idioma através de neurociência, cultura e segurança emocional.
      </p>
    </div>

    <!-- Destaque dos 4Ps e 3Rs -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <div class="glass-card p-6 rounded-2xl border-l-4 border-l-indigo-500 bg-gradient-to-r from-indigo-950/40 to-slate-900/60">
        <div class="flex items-center gap-3 mb-2">
          <span class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-300 flex items-center justify-center font-bold text-sm">4P</span>
          <h3 class="text-lg font-heading font-bold text-white">Treine os 4P da Fala Fluente</h3>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          <strong class="text-white">Padrões</strong> (conexões sonoras da fala real), <strong class="text-white">Pronúncia</strong> (músculos da articulação), <strong class="text-white">Psicológico</strong> (destravar sem medo do julgamento) e <strong class="text-white">Prática</strong> direcionada.
        </p>
      </div>

      <div class="glass-card p-6 rounded-2xl border-l-4 border-l-teal-500 bg-gradient-to-r from-teal-950/40 to-slate-900/60">
        <div class="flex items-center gap-3 mb-2">
          <span class="w-8 h-8 rounded-lg bg-teal-500/20 text-teal-300 flex items-center justify-center font-bold text-sm">3R</span>
          <h3 class="text-lg font-heading font-bold text-white">Aquisição 3R: Fixação Permanente</h3>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          <strong class="text-white">Revisão</strong> espaçada inteligente, <strong class="text-white">Repetição</strong> ativa contextual e <strong class="text-white">Reapresentação</strong> em múltiplos estímulos (auditivo, visual e fala).
        </p>
      </div>
    </div>

    <!-- Grid dos 9 Pilares -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((pillar) => (
        <div class="glass-card p-6 rounded-2xl flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class={`w-12 h-12 rounded-xl bg-gradient-to-br ${pillar.color} text-white flex items-center justify-center font-heading font-black text-2xl shadow-md group-hover:scale-110 transition-transform`}>
                {pillar.letter}
              </span>
              <span class="text-[11px] font-semibold text-slate-400 bg-white/5 border border-white/10 px-2.5 py-1 rounded-full">
                {pillar.tag}
              </span>
            </div>
            <h3 class="text-lg font-heading font-bold text-white group-hover:text-indigo-300 transition-colors">
              {pillar.name}
            </h3>
            <h4 class="text-xs font-semibold text-indigo-400 mt-1 mb-3">
              {pillar.subtitle}
            </h4>
            <p class="text-sm text-slate-300 leading-relaxed">
              {pillar.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA de Aprofundamento -->
    <div class="mt-12 text-center">
      <a href="/metodo" class="btn-secondary !text-sm">
        <span>Conhecer todos os detalhes da Metodologia Autêntica</span>
        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>
