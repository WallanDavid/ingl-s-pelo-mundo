<script>
  // Controla a alternância fluida entre as abas do Tour da Plataforma
  document.addEventListener('DOMContentLoaded', () => {
    const tourButtons = document.querySelectorAll<HTMLButtonElement>('[data-tour-tab]');
    const tourPanels = document.querySelectorAll<HTMLElement>('.tour-panel');

    tourButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabKey = btn.getAttribute('data-tour-tab');
        if (!tabKey) return;

        // Atualiza estado dos botões
        tourButtons.forEach(b => {
          b.classList.remove('active', 'bg-blue-600/30', 'border-blue-500/50', 'text-white');
          b.classList.add('text-slate-400', 'border-transparent');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('active', 'bg-blue-600/30', 'border-blue-500/50', 'text-white');
        btn.classList.remove('text-slate-400', 'border-transparent');
        btn.setAttribute('aria-selected', 'true');

        // Alterna os painéis
        tourPanels.forEach(panel => {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        });

        const activePanel = document.getElementById(`tour-panel-${tabKey}`);
        if (activePanel) {
          activePanel.classList.remove('hidden');
          activePanel.classList.add('block');
        }
      });
    });
  });
</script>
