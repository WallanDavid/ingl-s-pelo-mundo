---
// src/components/Footer.astro
// Rodapé Oficial — Fluente no Mundo | Prof. Amanda Beatriz
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#040408] border-t border-white/10 text-slate-400 text-xs relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      
      <!-- Coluna da Marca Oficial -->
      <div class="lg:col-span-2 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-3.5 group">
          <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/15 flex items-center justify-center p-1.5">
            <img src="/images/logo-white.png" alt="Fluente no Mundo" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col">
            <span class="font-heading font-black text-lg tracking-tight text-white group-hover:text-[#c8c2ff] transition-colors leading-none">
              Fluente no Mundo
            </span>
            <span class="text-[11px] uppercase tracking-widest text-slate-400 font-medium mt-1">
              Prof. Amanda Beatriz
            </span>
          </div>
        </a>

        <p class="text-slate-300 text-xs leading-relaxed max-w-sm font-sans">
          Uma nova era dos estudos. Idiomas conectados com identidade, constância, visão de futuro e neurociência aplicada para você falar com liberdade e naturalidade.
        </p>

        <!-- Selos de Segurança -->
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] text-slate-300">
            🔒 Pagamento Seguro SSL
          </span>
          <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] text-slate-300">
            🛡️ Garantia de 7 Dias
          </span>
          <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] text-slate-300">
            ⚡ Acesso Imediato
          </span>
        </div>
      </div>

      <!-- Coluna: A Viagem e Métodos -->
      <div>
        <h3 class="text-white font-heading font-bold text-xs tracking-wider uppercase mb-4">
          A Viagem & Métodos
        </h3>
        <ul class="flex flex-col gap-2.5 font-sans">
          <li><a href="/#viagem" class="hover:text-white transition-colors">Passaporte do Aluno</a></li>
          <li><a href="/#metodo" class="hover:text-white transition-colors">Método A.U.T.E.N.T.I.C.A</a></li>
          <li><a href="/#metodo" class="hover:text-white transition-colors">Os 4Ps da Pronúncia</a></li>
          <li><a href="/#comparativo" class="hover:text-white transition-colors">Comparativo de Rotas</a></li>
          <li><a href="/#roteiro" class="hover:text-white transition-colors">Simulador de Roteiro</a></li>
        </ul>
      </div>

      <!-- Coluna: Ecossistema de Produtos -->
      <div>
        <h3 class="text-white font-heading font-bold text-xs tracking-wider uppercase mb-4">
          15 Produtos
        </h3>
        <ul class="flex flex-col gap-2.5 font-sans">
          <li><a href="/#produtos" class="hover:text-white transition-colors">Formação Global</a></li>
          <li><a href="/#produtos" class="hover:text-white transition-colors">Jornada Poliglota (12 Línguas)</a></li>
          <li><a href="/#produtos" class="hover:text-white transition-colors">Imersão com a Prof</a></li>
          <li><a href="/#produtos" class="hover:text-white transition-colors">Minuto Fluente</a></li>
          <li><a href="/#produtos" class="hover:text-white transition-colors">Revisão Autêntica SRS</a></li>
        </ul>
      </div>

      <!-- Coluna: Acesso Oficial & Termos -->
      <div>
        <h3 class="text-white font-heading font-bold text-xs tracking-wider uppercase mb-4">
          Acesso & Apoio
        </h3>
        <ul class="flex flex-col gap-2.5 font-sans">
          <li>
            <a 
              href="https://alunos.fluentenomundo.com/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 font-bold"
            >
              <span>Área do Aluno (Login)</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </li>
          <li><a href="/#planos" class="hover:text-white transition-colors">Planos Oficiais</a></li>
          <li><a href="/#faq" class="hover:text-white transition-colors">Dúvidas Frequentes</a></li>
          <li><a href="/privacidade" class="hover:text-white transition-colors">Privacidade</a></li>
          <li><a href="/termos" class="hover:text-white transition-colors">Termos de Uso</a></li>
        </ul>
      </div>

    </div>

    <!-- Divisor e Rodapé Inferior -->
    <div class="pt-8 mt-12 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500 font-sans">
      <p>
        © {currentYear} Fluente no Mundo — Prof. Amanda Beatriz. Todos os direitos reservados.
      </p>
      <div class="flex items-center gap-3">
        <a href="https://fluentenomundo.com/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">
          fluentenomundo.com
        </a>
        <span>•</span>
        <a href="https://alunos.fluentenomundo.com/" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors font-semibold">
          alunos.fluentenomundo.com
        </a>
      </div>
    </div>
  </div>
</footer>
