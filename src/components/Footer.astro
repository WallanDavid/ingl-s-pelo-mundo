---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#070a14] border-t border-white/10 text-slate-400 text-sm mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      
      <!-- Coluna da Marca -->
      <div class="lg:col-span-2 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-3">
          <img 
            src="/images/logo white.png" 
            alt="Logo Fluente no Mundo" 
            class="h-9 w-auto object-contain"
            onerror="this.style.display='none'"
          />
          <div class="flex flex-col">
            <span class="font-heading font-extrabold text-xl tracking-tight text-white">
              Fluente no Mundo
            </span>
            <span class="text-[10px] uppercase tracking-widest text-indigo-400 font-semibold -mt-1">
              Método Amanda Beatriz
            </span>
          </div>
        </a>

        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          A escola e plataforma de idiomas que une neurociência aplicada, aculturamento real, aulas ao vivo semanais com a professora e ferramentas práticas para você falar com naturalidade.
        </p>

        <!-- Redes Sociais Oficiais -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://youtube.com/@fluentenomundo"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white/5 hover:bg-red-500/20 hover:text-red-400 border border-white/10 flex items-center justify-center transition-all"
            aria-label="Canal no YouTube Fluente no Mundo"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
          
          <a
            href="https://instagram.com/fluentenomundo"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white/5 hover:bg-pink-500/20 hover:text-pink-400 border border-white/10 flex items-center justify-center transition-all"
            aria-label="Instagram Fluente no Mundo"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Coluna: Conteúdo & Método -->
      <div>
        <h3 class="text-white font-heading font-semibold text-sm tracking-wider uppercase mb-4">
          Aprendizagem
        </h3>
        <ul class="flex flex-col gap-2.5">
          <li><a href="/metodo" class="hover:text-indigo-300 transition-colors">Método A.U.T.E.N.T.I.C.A</a></li>
          <li><a href="/formacao-global" class="hover:text-indigo-300 transition-colors">Formações Essenciais</a></li>
          <li><a href="/plataforma" class="hover:text-indigo-300 transition-colors">A Plataforma do Aluno</a></li>
          <li><a href="/idiomas" class="hover:text-indigo-300 transition-colors">Jornada Poliglota</a></li>
          <li><a href="/imersao" class="hover:text-indigo-300 transition-colors">Masterclasses ao Vivo</a></li>
        </ul>
      </div>

      <!-- Coluna: Institucional & Matrícula -->
      <div>
        <h3 class="text-white font-heading font-semibold text-sm tracking-wider uppercase mb-4">
          Institucional
        </h3>
        <ul class="flex flex-col gap-2.5">
          <li><a href="/sobre" class="hover:text-indigo-300 transition-colors">Prof. Amanda Beatriz</a></li>
          <li><a href="/planos" class="hover:text-indigo-300 transition-colors">Planos & Matrícula</a></li>
          <li><a href="/faq" class="hover:text-indigo-300 transition-colors">Perguntas Frequentes</a></li>
          <li><a href="/contato" class="hover:text-indigo-300 transition-colors">Fale Conosco / Suporte</a></li>
          <li>
            <a 
              href="https://alunos.fluentenomundo.com" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-indigo-400 hover:text-indigo-300 font-medium"
            >
              Área do Aluno ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna: Confiança & Segurança -->
      <div>
        <h3 class="text-white font-heading font-semibold text-sm tracking-wider uppercase mb-4">
          Segurança & LGPD
        </h3>
        <ul class="flex flex-col gap-2.5">
          <li><a href="/privacidade" class="hover:text-indigo-300 transition-colors">Política de Privacidade</a></li>
          <li><a href="/termos" class="hover:text-indigo-300 transition-colors">Termos de Uso</a></li>
        </ul>
        <div class="mt-6 p-4 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-400 flex flex-col gap-2">
          <div class="flex items-center gap-2 text-emerald-400 font-semibold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Garantia de 7 Dias
          </div>
          <p>
            Teste a plataforma por 7 dias com acesso completo. Caso não se adapte, reembolso integral garantido.
          </p>
        </div>
      </div>

    </div>

    <!-- Divisor e Rodapé Inferior -->
    <div class="pt-8 mt-12 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        © {currentYear} Fluente no Mundo. Todos os direitos reservados. CNPJ e infraestrutura educacional oficial.
      </p>
      <p class="flex items-center gap-2">
        <span>Desenvolvido com excelência técnica & Netlify SSG</span>
        <span>•</span>
        <span class="text-slate-400">Em conformidade com a LGPD</span>
      </p>
    </div>
  </div>
</footer>
