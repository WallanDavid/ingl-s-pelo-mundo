---
// Componente de Prova Social e Depoimentos Reais dos Alunos
// Apresenta capturas autênticas de alunos que destravaram o inglês com a Prof. Amanda Beatriz.

const testimonials = [
  {
    name: 'Márcia',
    role: 'Aluna Fluente no Mundo',
    badge: 'Destravou em Reuniões',
    image: '/images/depoimento 2.o marcia.png',
    highlight: '“Perdi completamente o pânico de falar inglês no trabalho.”',
    story: 'Conseguiu participar com segurança das reuniões globais da empresa após destravar a pronúncia com o método 4P.'
  },
  {
    name: 'Felipe',
    role: 'Aluno Fluente no Mundo',
    badge: 'Aprovado em Entrevista',
    image: '/images/depoimento 3.o felipe.png',
    highlight: '“A metodologia fez em 3 meses o que 4 anos de cursinho não fizeram.”',
    story: 'Destravou a conversação ativa e passou no processo seletivo para uma multinacional.'
  },
  {
    name: 'Diego',
    role: 'Aluno Fluente no Mundo',
    badge: 'Fluência Sem Decoreba',
    image: '/images/depoimento 3.o diego.png',
    highlight: '“O sistema de repetição espaçada e as aulas ao vivo mudaram tudo.”',
    story: 'Fixou mais de 2.000 expressões no banco pessoal e hoje assiste séries e podcasts sem traduzir mentalmente.'
  },
  {
    name: 'Jaqueline',
    role: 'Aluna Fluente no Mundo',
    badge: 'Viagem Internacional',
    image: '/images/depoimento 3.o jaqueline.png',
    highlight: '“Viajei para o exterior e conversei sem pedir ajuda para ninguém!”',
    story: 'Passou pela imigração, fez pedidos e interagiu com nativos com total autonomia e tranquilidade.'
  },
  {
    name: 'Gabriel',
    role: 'Aluno Fluente no Mundo',
    badge: 'Pronúncia Natural',
    image: '/images/depoimento 3.o gabriel.png',
    highlight: '“O feedback do SOS Professora corrigiu o que nenhum app corrigia.”',
    story: 'Ajustou os pontos articulatórios dos 4Ps e recebeu elogios dos colegas de trabalho pelo ritmo natural.'
  },
  {
    name: 'Paloma',
    role: 'Aluna Fluente no Mundo',
    badge: 'Superou o Bloqueio',
    image: '/images/depoimento 3.o paloma.png',
    highlight: '“O acolhimento da Amanda me fez perder a vergonha de errar.”',
    story: 'Transformou o medo em prática diária de 20 minutos com acolhimento e segurança psicológica.'
  },
  {
    name: 'Paulo',
    role: 'Aluno Fluente no Mundo',
    badge: 'Rotina de 20 Minutos',
    image: '/images/depoimento 3.o paulo.png',
    highlight: '“Com rotina corrida, o cronograma diário foi a minha salvação.”',
    story: 'Encaixou o estudo no trajeto do trabalho e manteve mais de 120 dias de streak ininterrupto.'
  },
  {
    name: 'Raulino',
    role: 'Aluno Fluente no Mundo',
    badge: 'Evolução Contínua',
    image: '/images/depoimento 3.o raulino.png',
    highlight: '“As masterclasses de quarta-feira são o ponto alto da semana.”',
    story: 'Aprendeu expressões reais da fala coloquial que nenhuma escola tradicional ensina.'
  }
];
---

<section id="depoimentos" class="py-20 lg:py-28 bg-[#f8fafc] border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabeçalho da Seção -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold uppercase tracking-wider mb-4">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span>Histórias Reais · Prova Social Irrefutável</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-slate-900 tracking-tight leading-tight">
        Quem estuda com o Método Autêntico fala com liberdade.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Veja as mensagens e relatos espontâneos de alunos que superaram a vergonha, destravam o inglês no trabalho e hoje viajam o mundo com total independência.
      </p>
    </div>

    <!-- Grid de Depoimentos em Cards com Imagens Reais -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {testimonials.map((t) => (
        <div class="editorial-card p-4 bg-white flex flex-col justify-between hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-md border border-slate-200">
          <div>
            <!-- Imagem do Print Real do Aluno -->
            <div class="aspect-square rounded-xl overflow-hidden bg-slate-100 border border-slate-200 mb-4 relative group">
              <img
                src={t.image}
                alt={`Depoimento real de ${t.name} - Aluno Fluente no Mundo`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute top-2 right-2 px-2 py-0.5 rounded-full bg-slate-950/80 backdrop-blur-md text-[10px] font-mono font-bold text-white flex items-center gap-1">
                <span>Verificado</span>
                <svg class="w-3 h-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              </div>
            </div>

            <!-- Identificação e Tag -->
            <div class="flex items-center justify-between gap-2 mb-2">
              <strong class="text-slate-900 font-heading text-sm font-bold">
                {t.name}
              </strong>
              <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                {t.badge}
              </span>
            </div>

            <!-- Citação Destacada -->
            <p class="text-xs font-semibold text-slate-800 leading-snug mb-2 italic">
              {t.highlight}
            </p>

            <!-- História Resumida -->
            <p class="text-[11px] text-slate-500 leading-relaxed">
              {t.story}
            </p>
          </div>

          <!-- Estrelas de Avaliação -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
            <div class="flex text-amber-500 gap-0.5">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <span class="text-[11px] text-slate-500 font-medium">Nota 5.0</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Chamada Comercial de Ação da Seção -->
    <div class="mt-14 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">
            <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div class="text-left">
            <strong class="text-slate-900 text-sm block">Você também pode destravar o seu inglês este ano.</strong>
            <span class="text-xs text-slate-500">Matrículas abertas a partir de R$ 39,90/mês com garantia de 7 dias.</span>
          </div>
        </div>
        <a
          href="#planos"
          class="btn-editorial-primary !py-3 !px-6 !text-xs whitespace-nowrap"
        >
          <span>Quero Ser o Próximo Aluno Fluente &rarr;</span>
        </a>
      </div>
    </div>

  </div>
</section>
