      btn.addEventListener('click', () => {
        const day = btn.getAttribute('data-day') || 'qua';
        dayButtons.forEach(b => {
          b.classList.remove('active', 'bg-blue-600/40', 'border-blue-500');
          b.classList.add('bg-white/5', 'border-white/10');
        });
        btn.classList.add('active', 'bg-blue-600/40', 'border-blue-500');
        btn.classList.remove('bg-white/5', 'border-white/10');

        const data = weekDays[day];
        if (data && dayTitle && dayType && dayLessonTitle && dayLessonDesc && dayDuration && dayTool) {
          dayTitle.textContent = data.title;
          dayType.textContent = data.type;
          dayLessonTitle.textContent = data.lesson;
          dayLessonDesc.textContent = data.desc;
          dayDuration.textContent = data.dur;
          dayTool.textContent = data.tool;
        }
      });
    });

    // 3. Adicionar Vocabulário Local de Teste
    const addVocabForm = document.getElementById('add-vocab-form');
    const inputTerm = document.getElementById('input-vocab-term') as HTMLInputElement | null;
    const inputMeaning = document.getElementById('input-vocab-meaning') as HTMLInputElement | null;
    const vocabGrid = document.getElementById('vocab-items-grid');
    const vocabFeedback = document.getElementById('vocab-feedback-msg');

    if (addVocabForm && inputTerm && inputMeaning && vocabGrid) {
      addVocabForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const term = inputTerm.value.trim();
        const meaning = inputMeaning.value.trim();
        if (!term || !meaning) return;

        const newCard = document.createElement('div');
        newCard.className = 'p-4 rounded-xl bg-slate-900/90 border border-emerald-500/40 space-y-2';
        newCard.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-emerald-400">/novo termo local/</span>
            <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded font-mono">Adicionado Agora</span>
          </div>
          <h4 class="text-base font-bold text-white">${term}</h4>
          <p class="text-xs text-slate-300">${meaning}</p>
          <div class="pt-2 border-t border-white/5 text-[11px] text-slate-400 italic">
            "Cadastrado localmente no seu banco de teste."
          </div>
        `;

        vocabGrid.prepend(newCard);
        inputTerm.value = '';
        inputMeaning.value = '';
        if (vocabFeedback) {
          vocabFeedback.classList.remove('hidden');
          setTimeout(() => vocabFeedback.classList.add('hidden'), 4000);
        }
      });
    }

    // 4. Síntese de Áudio Nativa do Navegador na Revisão SRS (Web Speech API)
    const btnAudio = document.getElementById('btn-srs-audio');
    const srsTerm = document.getElementById('srs-term');
    const btnReveal = document.getElementById('btn-srs-reveal');
    const revealPanel = document.getElementById('srs-translation-reveal');

    if (btnAudio) {
      btnAudio.addEventListener('click', () => {
        const textToSpeak = srsTerm ? srsTerm.textContent?.replace(/"/g, '').trim() : 'Get the hang of it';
        if ('speechSynthesis' in window && textToSpeak) {
          const utterance = new SpeechSynthesisUtterance(textToSpeak);
          utterance.lang = 'en-US';
          utterance.rate = 0.9;
          window.speechSynthesis.speak(utterance);
        } else {
          alert('Áudio demonstrativo: Pronúncia nativa em inglês vocalizada!');
        }
      });
    }

    if (btnReveal && revealPanel) {
      btnReveal.addEventListener('click', () => {
        revealPanel.classList.toggle('hidden');
      });
    }

    // 5. Check-in Diário Interativo (+10 pontos)
    const btnCheckin = document.getElementById('btn-make-checkin');
    const pointsCounter = document.getElementById('points-counter-value');
    const checkinBtnText = document.getElementById('checkin-btn-text');

    if (btnCheckin && pointsCounter && checkinBtnText) {
      let points = 1420;
      let checkedIn = false;

      btnCheckin.addEventListener('click', () => {
        if (!checkedIn) {
          points += 10;
          pointsCounter.textContent = `${points.toLocaleString('pt-BR')} pts`;
          checkinBtnText.textContent = 'Check-in Realizado Hoje (+10 pts adicionados)';
          btnCheckin.classList.remove('btn-editorial-primary');
          btnCheckin.classList.add('bg-emerald-600', 'text-white', 'cursor-default');
          checkedIn = true;
        }
      });
    }

    // 6. Simulação do SOS Professora
    const btnSos = document.getElementById('btn-simulate-sos');
    const sosResponseText = document.getElementById('sos-response-text');
    const sosStatusTag = document.getElementById('sos-status-tag');
    const sosSelect = document.getElementById('sos-sample-select') as HTMLSelectElement | null;

    if (btnSos && sosResponseText && sosStatusTag) {
      btnSos.addEventListener('click', () => {
        btnSos.textContent = 'Enviando dúvida à Prof. Amanda...';
        btnSos.setAttribute('disabled', 'true');

        setTimeout(() => {
          btnSos.textContent = 'Dúvida Enviada com Sucesso!';
          sosStatusTag.textContent = 'Nova Resposta Recebida (Concluído)';
          sosStatusTag.className = 'text-[10px] font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded';

          if (sosSelect && sosSelect.value === 'connected') {
            sosResponseText.innerHTML = `
              "Excelente pergunta! 'Wanna' (want to) e 'gotta' (have got to) são reduções naturais do inglês falado. Não são erros gramaticais na fala coloquial, mas sim o padrão rítmico nativo. Assista à nossa aula gravada do dia 16/09 sobre elisões fonéticas para praticar junto com as gravações!"
            `;
          } else {
            sosResponseText.innerHTML = `
              "Olá! Ouvi sua dúvida sobre o som do 'TH'. O segredo é posicionar a ponta da língua levemente entre os dentes incisivos superiores e soltar o ar sem vibrar as cordas vocais para 'think' e com vibração suave para 'this'. Grave um áudio na etapa 2 do SRS para eu ouvir sua evolução!"
            `;
          }
          btnSos.removeAttribute('disabled');
        }, 800);
      });
    }

  });
</script>
