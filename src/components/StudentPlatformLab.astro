---
// StudentPlatformLab.astro - Laboratório Interativo da Plataforma do Aluno (V3 Product-Led)
---

<div class="software-window overflow-hidden border border-slate-700/60 shadow-software rounded-2xl bg-[#090d16]">
  
  <!-- BARRA DE TÍTULO DA JANELA DE SOFTWARE -->
  <div class="software-window-header px-4 py-3 flex flex-wrap items-center justify-between gap-3 border-b border-white/10 bg-[#0c1220]/90">
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1.5 mr-2">
        <span class="w-3 h-3 rounded-full bg-slate-600 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-slate-600 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-slate-600 inline-block"></span>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-slate-300 bg-white/5 border border-white/10 px-3 py-1 rounded-md">
        <svg class="w-3 h-3 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>alunos.fluentenomundo.com/explorador</span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-[10px] font-mono tracking-wider uppercase text-blue-300 bg-blue-950/60 border border-blue-500/30 px-2.5 py-0.5 rounded-full font-semibold">
        Laboratório Interativo · Dados Simulados
      </span>
      <span class="text-[11px] text-slate-400 hidden sm:inline">
        Ambiente de Demonstração
      </span>
    </div>
  </div>

  <!-- SELETOR DE MÓDULOS (7 ABAS EM TEXTO LIMPO E SEM EMOJIS) -->
  <div class="bg-[#0b101c] border-b border-white/10 px-4 py-2 overflow-x-auto no-scrollbar" role="tablist" aria-label="Módulos da Plataforma">
    <div class="flex items-center gap-1.5 min-w-max">
      
      <button
        type="button"
        role="tab"
        id="tab-btn-cronograma"
        data-target="lab-panel-cronograma"
        class="lab-nav-btn active px-3.5 py-2 rounded-lg text-xs font-semibold text-white bg-blue-600/30 border border-blue-500/50 flex items-center gap-2 transition-all"
        aria-selected="true"
      >
        <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>1. Formação & Cronograma</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-btn-vocabulario"
        data-target="lab-panel-vocabulario"
        class="lab-nav-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 hover:bg-white/5 border border-transparent flex items-center gap-2 transition-all"
        aria-selected="false"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>2. Vocabulário Ativo</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-btn-srs"
        data-target="lab-panel-srs"
        class="lab-nav-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 hover:bg-white/5 border border-transparent flex items-center gap-2 transition-all"
        aria-selected="false"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>3. Revisão SRS (3 Etapas)</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-btn-gamificacao"
        data-target="lab-panel-gamificacao"
        class="lab-nav-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 hover:bg-white/5 border border-transparent flex items-center gap-2 transition-all"
        aria-selected="false"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
        <span>4. Conquista & Constância</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-btn-vivencia"
        data-target="lab-panel-vivencia"
        class="lab-nav-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 hover:bg-white/5 border border-transparent flex items-center gap-2 transition-all"
        aria-selected="false"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
        </svg>
        <span>5. Vivência Global</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-btn-imersao"
        data-target="lab-panel-imersao"
        class="lab-nav-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 hover:bg-white/5 border border-transparent flex items-center gap-2 transition-all"
        aria-selected="false"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span>6. Imersão com a Prof</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-btn-sos"
        data-target="lab-panel-sos"
        class="lab-nav-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 hover:bg-white/5 border border-transparent flex items-center gap-2 transition-all"
        aria-selected="false"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span>7. SOS Professora</span>
      </button>

    </div>
  </div>

  <!-- ÁREA DE CONTEÚDO DOS PAINÉIS -->
  <div class="p-4 sm:p-6 lg:p-8 bg-[#090d16] min-h-[460px] text-slate-200">
    
    <!-- PAINEL 1: FORMAÇÃO GLOBAL & CRONOGRAMA SEMANAL -->
    <div id="lab-panel-cronograma" class="lab-panel block">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <div class="lg:col-span-5 space-y-4">
          <div>
            <span class="text-[11px] font-mono uppercase tracking-wider text-blue-400 block mb-1">
              Documento: Courses & Dashboard
            </span>
            <h3 class="text-xl font-heading font-bold text-white">
              Formações & Cronograma Unificado
            </h3>
            <p class="text-xs text-slate-400 mt-1 leading-relaxed">
              O aluno não precisa escolher o que estudar sozinho. Cada formação possui metas diárias organizadas em uma grade semanal balanceada.
            </p>
          </div>

          <!-- Seleção de Formação Ativa -->
          <div class="space-y-2">
            <label class="text-[11px] font-semibold text-slate-300 uppercase tracking-wider block">
              Selecione a Formação:
            </label>
            <div class="space-y-1.5" id="course-selector-list">
              <button
                type="button"
                data-course="essencial"
                class="course-btn active w-full p-3 rounded-lg text-left text-xs bg-blue-950/40 border border-blue-500/40 text-white flex items-center justify-between"
              >
                <div>
                  <strong class="block text-blue-200">Inglês Essencial (Base do Método)</strong>
                  <span class="text-[11px] text-slate-400">Formação Obrigatória · 4 Trilhas Ativas</span>
                </div>
                <span class="text-[10px] bg-blue-500/20 text-blue-300 px-2 py-0.5 rounded font-mono">Em Andamento</span>
              </button>

              <button
                type="button"
                data-course="chave"
                class="course-btn w-full p-3 rounded-lg text-left text-xs bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10 flex items-center justify-between"
              >
                <div>
                  <strong class="block text-slate-200">Virando a Chave dos Estudos</strong>
                  <span class="text-[11px] text-slate-400">Metacognição & Neurociência da Memória</span>
                </div>
                <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded font-mono">Iniciada</span>
              </button>

              <button
                type="button"
                data-course="pronuncia"
                class="course-btn w-full p-3 rounded-lg text-left text-xs bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10 flex items-center justify-between"
              >
                <div>
                  <strong class="block text-slate-200">Dominando a Arte da Pronúncia</strong>
                  <span class="text-[11px] text-slate-400">Padrões de Vogais & Treinamento 4P</span>
                </div>
                <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded font-mono">Prática</span>
              </button>
            </div>
          </div>

          <!-- Barra de Progresso Demonstrativa -->
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
            <div class="flex items-center justify-between text-xs mb-2">
              <span class="text-slate-300 font-medium">Progresso no Módulo Trimestral</span>
              <span class="text-blue-400 font-bold font-mono">48% Concluído</span>
            </div>
            <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
              <div class="bg-blue-500 h-full w-[48%] rounded-full transition-all"></div>
            </div>
            <span class="text-[11px] text-slate-500 mt-2 block">
              Próximo marco: Certificado do Módulo 1 (Carga Horária: 60h)
            </span>
          </div>
        </div>

        <!-- Coluna Direita: Cronograma Semanal Interativo -->
        <div class="lg:col-span-7 bg-[#0c1220] p-4 sm:p-5 rounded-xl border border-white/10 space-y-4">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <div>
              <span class="text-xs font-semibold text-white block">Mapa de Foco Semanal</span>
              <span class="text-[11px] text-slate-400">Clique nos dias para inspecionar as aulas e metas diárias</span>
            </div>
            <span class="text-[10px] font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded">
              Semana Ativa
            </span>
          </div>

          <!-- Seletor de Dias da Semana -->
          <div class="grid grid-cols-7 gap-1 sm:gap-2 text-center" id="week-day-selector">
            <button type="button" data-day="seg" class="week-day-btn p-2 rounded-lg bg-white/5 border border-white/10 text-xs hover:bg-white/10 transition-all">
              <span class="block text-[10px] text-slate-400">SEG</span>
              <span class="font-bold text-white">05</span>
            </button>
            <button type="button" data-day="ter" class="week-day-btn p-2 rounded-lg bg-white/5 border border-white/10 text-xs hover:bg-white/10 transition-all">
              <span class="block text-[10px] text-slate-400">TER</span>
              <span class="font-bold text-white">06</span>
            </button>
            <button type="button" data-day="qua" class="week-day-btn active p-2 rounded-lg bg-blue-600/40 border border-blue-500 text-xs font-bold text-white transition-all">
              <span class="block text-[10px] text-blue-200">QUA</span>
              <span>07</span>
            </button>
            <button type="button" data-day="qui" class="week-day-btn p-2 rounded-lg bg-white/5 border border-white/10 text-xs hover:bg-white/10 transition-all">
              <span class="block text-[10px] text-slate-400">QUI</span>
              <span class="font-bold text-white">08</span>
            </button>
            <button type="button" data-day="sex" class="week-day-btn p-2 rounded-lg bg-white/5 border border-white/10 text-xs hover:bg-white/10 transition-all">
              <span class="block text-[10px] text-slate-400">SEX</span>
              <span class="font-bold text-white">09</span>
            </button>
            <button type="button" data-day="sab" class="week-day-btn p-2 rounded-lg bg-white/5 border border-white/10 text-xs hover:bg-white/10 transition-all">
              <span class="block text-[10px] text-slate-400">SÁB</span>
              <span class="font-bold text-white">10</span>
            </button>
            <button type="button" data-day="dom" class="week-day-btn p-2 rounded-lg bg-white/5 border border-white/10 text-xs hover:bg-white/10 transition-all">
              <span class="block text-[10px] text-slate-400">DOM</span>
              <span class="font-bold text-white">11</span>
            </button>
          </div>

          <!-- Card Dinâmico com a Meta do Dia Selecionado -->
          <div id="day-detail-card" class="p-4 rounded-xl bg-slate-900/90 border border-slate-700/80 space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span id="day-title" class="font-bold text-blue-300">Quarta-feira · Dia Principal de Aula ao Vivo</span>
              <span id="day-type" class="text-[10px] px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 font-mono">Aula ao Vivo + Prática</span>
            </div>
            
            <div>
              <h4 id="day-lesson-title" class="text-sm font-bold text-white">
                Masterclass Semanal: Conexões Sonoras e Vogais Curtas
              </h4>
              <p id="day-lesson-desc" class="text-xs text-slate-300 mt-1 leading-relaxed">
                Aula prática com a Prof. Amanda Beatriz. Foco no reconhecimento do ritmo de fala nativa e eliminação da tradução mecânica.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-2 pt-2 border-t border-white/10 text-[11px] text-slate-400">
              <div>
                <span class="block text-slate-500">Duração Recomendada:</span>
                <strong id="day-duration" class="text-white font-mono">45 minutos</strong>
              </div>
              <div>
                <span class="block text-slate-500">Ferramenta de Apoio:</span>
                <strong id="day-tool" class="text-white">Transmissão + Resumo em PDF</strong>
              </div>
            </div>

            <div class="pt-2">
              <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="check-lesson-completed" class="rounded border-slate-700 text-blue-600 focus:ring-blue-500">
                <span>Marcar aula de hoje como concluída no cronograma</span>
              </label>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- PAINEL 2: VOCABULÁRIO ATIVO -->
    <div id="lab-panel-vocabulario" class="lab-panel hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/10 pb-4">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-blue-400 block mb-0.5">
            Documento: Vocabulary PDF
          </span>
          <h3 class="text-xl font-heading font-bold text-white">
            Banco de Vocabulário & Repetição Inteligente
          </h3>
          <p class="text-xs text-slate-400 mt-1">
            Meta ativa de 20.000 expressões dominadas para autonomia de comunicação.
          </p>
        </div>

        <!-- Seletor de Idioma -->
        <div class="flex items-center gap-1.5" id="vocab-lang-selector">
          <button type="button" data-lang="en" class="vocab-lang-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-600/30 text-white border border-blue-500/40">
            Inglês
          </button>
          <button type="button" data-lang="es" class="vocab-lang-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/5 text-slate-400 hover:text-white border border-white/10">
            Espanhol
          </button>
          <button type="button" data-lang="it" class="vocab-lang-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/5 text-slate-400 hover:text-white border border-white/10">
            Italiano
          </button>
          <button type="button" data-lang="fr" class="vocab-lang-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/5 text-slate-400 hover:text-white border border-white/10">
            Francês
          </button>
        </div>
      </div>

      <!-- Grade de Expressões em Exibição -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="vocab-items-grid">
        <div class="p-4 rounded-xl bg-slate-900/90 border border-white/10 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-blue-400">/ɡɛt ðə hæŋ əv ɪt/</span>
            <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded font-mono">Dominada</span>
          </div>
          <h4 class="text-base font-bold text-white">Get the hang of it</h4>
          <p class="text-xs text-slate-300">Pegar o jeito / se acostumar com uma prática.</p>
          <div class="pt-2 border-t border-white/5 text-[11px] text-slate-400 italic">
            "Once you practice daily, you'll get the hang of it."
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/90 border border-white/10 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-blue-400">/ˈfɪɡ.jɚ aʊt/</span>
            <span class="text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded font-mono">Em Revisão</span>
          </div>
          <h4 class="text-base font-bold text-white">Figure out</h4>
          <p class="text-xs text-slate-300">Compreender, solucionar ou encontrar uma saída.</p>
          <div class="pt-2 border-t border-white/5 text-[11px] text-slate-400 italic">
            "We need to figure out how this pronunciation works."
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/90 border border-white/10 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-blue-400">/kiːp ʌp/</span>
            <span class="text-[10px] bg-blue-500/20 text-blue-300 px-2 py-0.5 rounded font-mono">Nova Expressão</span>
          </div>
          <h4 class="text-base font-bold text-white">Keep up with</h4>
          <p class="text-xs text-slate-300">Acompanhar o ritmo de algo ou alguém.</p>
          <div class="pt-2 border-t border-white/5 text-[11px] text-slate-400 italic">
            "It is easy to keep up with the weekly schedule."
          </div>
        </div>
      </div>

      <!-- Formulário para Inserção de Expressão de Teste -->
      <div class="p-4 rounded-xl bg-[#0c1220] border border-white/10">
        <h4 class="text-xs font-bold text-white mb-2 uppercase tracking-wider">
          Simular Inserção no Banco Pessoal
        </h4>
        <form id="add-vocab-form" class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <input
            type="text"
            id="input-vocab-term"
            placeholder="Expressão (ex: Look forward to)"
            required
            class="px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-blue-500"
          />
          <input
            type="text"
            id="input-vocab-meaning"
            placeholder="Significado (ex: Aguardar com ansiedade)"
            required
            class="px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-blue-500"
          />
          <button
            type="submit"
            class="btn-editorial-accent !py-2 !text-xs"
          >
            Adicionar ao Banco Local
          </button>
        </form>
        <span id="vocab-feedback-msg" class="text-[11px] text-emerald-400 mt-2 block hidden">
          Expressão adicionada com sucesso ao banco demonstrativo da sessão!
        </span>
      </div>
    </div>

    <!-- PAINEL 3: REVISÃO AUTÊNTICA SRS (OUVIR &rarr; PRONUNCIAR &rarr; TRADUZIR) -->
    <div id="lab-panel-srs" class="lab-panel hidden space-y-6">
      <div class="border-b border-white/10 pb-4">
        <span class="text-[11px] font-mono uppercase tracking-wider text-blue-400 block mb-0.5">
          Documento: Revisao Autentica PDF
        </span>
        <h3 class="text-xl font-heading font-bold text-white">
          Ciclo de Revisão: Ouvir &rarr; Pronunciar &rarr; Traduzir
        </h3>
        <p class="text-xs text-slate-400 mt-1">
