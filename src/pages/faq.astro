---
// src/pages/faq.astro
// Central de Perguntas Frequentes — Fluente no Mundo
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqOfficial from '../components/FaqOfficial.astro';

const pageTitle = 'Perguntas Frequentes (FAQ) | Fluente no Mundo';
const pageDesc = 'Tire todas as suas dúvidas sobre os 15 produtos, aulas ao vivo, metodologia A.U.T.E.N.T.I.C.A, SOS Professora, cancelamento e garantia.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/faq"
>
  
  <section class="pt-16 pb-8 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff]">
        <span>Central de Respostas</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-serif text-white tracking-tight leading-tight">
        Perguntas Frequentes
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
        Respostas transparentes e objetivas para você embarcar com total segurança.
      </p>
    </div>
  </section>

  <FaqOfficial />

  <section class="py-16 text-center border-t border-white/10 bg-[#05050a]">
    <div class="max-w-xl mx-auto px-4 space-y-4">
      <a href="/planos" class="btn-white-luxury px-8 py-3.5 text-xs uppercase tracking-wider inline-flex items-center gap-2 shadow-lg">
        <span>Garantir Matrícula Agora &rarr;</span>
      </a>
      <p class="text-xs text-slate-400">
        Ainda tem dúvidas? Fale conosco pelo 
        <a href="/contato" class="text-[#c8c2ff] hover:underline font-semibold ml-1">
          nosso canal de atendimento
        </a>.
      </p>
    </div>
  </section>

</BaseLayout>
