---
// src/pages/contato.astro
// Atendimento e Canais Oficiais — Fluente no Mundo
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Fale Conosco | Atendimento e Suporte Fluente no Mundo';
const pageDesc = 'Entre em contato com a equipe do Fluente no Mundo. Tire dúvidas sobre matrículas, metodologia ou suporte pedagógico.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/contato"
>
  
  <!-- CABEÇALHO DA PÁGINA -->
  <section class="pt-16 pb-12 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff]">
        <span>Atendimento & Apoio</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-serif text-white tracking-tight leading-tight">
        Fale com a <em class="italic font-normal text-[#c8c2ff]">nossa equipe.</em>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
        Estamos à disposição para orientar sua escolha de plano ou esclarecer qualquer dúvida sobre o ecossistema Fluente no Mundo.
      </p>
    </div>
  </section>

  <section class="py-16 bg-[#070812] border-t border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Formulário Seguro de Contato -->
        <div class="lg:col-span-7">
          <div class="glass-card p-6 sm:p-8">
            <h2 class="text-2xl font-serif text-white mb-2">Envie uma Mensagem</h2>
            <p class="text-xs text-slate-400 mb-6">Respondemos em até 24 horas úteis por e-mail ou WhatsApp.</p>

            <div id="contact-success-msg" class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs text-center font-semibold mb-4">
              Mensagem enviada com sucesso! Nossa equipe entrará em contato em até 24 horas.
            </div>

            <form id="contact-form" class="space-y-4">
              <div>
                <label for="name" class="block text-xs font-semibold text-slate-300 mb-1">Seu Nome Completo</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#9b8fff] focus:border-[#9b8fff] transition-colors"
                  placeholder="Ex.: Juliana Silva"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold text-slate-300 mb-1">Seu Melhor E-mail</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#9b8fff] focus:border-[#9b8fff] transition-colors"
                  placeholder="exemplo@gmail.com"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-semibold text-slate-300 mb-1">Assunto</label>
                <select
                  id="subject"
                  name="subject"
                  class="w-full px-4 py-3 rounded-xl bg-[#0e1022] border border-white/10 text-white text-sm focus:outline-none focus:ring-2 focus:ring-[#9b8fff] focus:border-[#9b8fff] transition-colors"
                >
                  <option value="duvida_matricula">Dúvida sobre matrícula ou planos (R$ 39,90)</option>
                  <option value="metodologia">Dúvida sobre o Método A.U.T.E.N.T.I.C.A</option>
                  <option value="pagamento">Formas de pagamento e PIX</option>
                  <option value="outro">Outro assunto</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-xs font-semibold text-slate-300 mb-1">Sua Mensagem</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-[#9b8fff] focus:border-[#9b8fff] transition-colors resize-none"
                  placeholder="Como podemos te ajudar hoje?"
                ></textarea>
              </div>

              <button
                type="submit"
                class="btn-white-luxury w-full text-center text-xs uppercase tracking-wider font-bold !py-3.5"
              >
                Enviar Mensagem
              </button>
            </form>
          </div>
        </div>

        <!-- Canais Rápidos & Contatos Oficiais -->
        <div class="lg:col-span-5 flex flex-col gap-5">

          <div class="glass-card p-6">
            <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full uppercase inline-block mb-3">
              Área do Aluno
            </span>
            <h3 class="text-xl font-serif text-white mb-2">Já é Aluno Matriculado?</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Acesse o canal exclusivo <strong>SOS Professora</strong> dentro da sua plataforma para tirar dúvidas diretamente com a Prof. Amanda Beatriz.
            </p>
            <a
              href="https://alunos.fluentenomundo.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost-cosmic w-full text-center text-xs font-semibold !py-3 flex items-center justify-center gap-2"
            >
              <span>Acessar Login Oficial</span>
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

          <div class="glass-card p-6 space-y-3">
            <h3 class="text-base font-serif text-white">Canais Oficiais</h3>
            <ul class="text-xs text-slate-300 space-y-2.5">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-red-400"></span>
                <span><strong>YouTube:</strong> youtube.com/@fluentenomundo</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-pink-400"></span>
                <span><strong>Instagram:</strong> instagram.com/fluentenomundo</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span><strong>Horário:</strong> Segunda a Sexta, das 09h às 18h</span>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('contact-success-msg');
    if (form && successMsg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        successMsg.classList.remove('hidden');
        form.reset();
        setTimeout(() => {
          successMsg.classList.add('hidden');
        }, 5000);
      });
    }
  </script>

</BaseLayout>
