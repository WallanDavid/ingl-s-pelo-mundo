---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Fale Conosco | Atendimento e Suporte Fluente no Mundo';
const pageDesc = 'Entre em contato com a equipe do Fluente no Mundo. Tire dúvidas sobre matrículas, parcerias ou suporte pedagógico.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/contato"
>
  
  <!-- CABEÇALHO DA PÁGINA -->
  <section class="pt-12 pb-16 bg-[#f8fafc] border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="badge-subtle mb-4">Atendimento Humano</span>
      <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-slate-900 tracking-tight leading-tight mt-3">
        Fale com a Nossa Equipe
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
        Estamos prontos para orientar sua escolha de plano ou esclarecer qualquer dúvida sobre o ecossistema Fluente no Mundo.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Formulário Seguro de Contato -->
        <div class="lg:col-span-7">
          <div class="editorial-card p-8">
            <h2 class="text-2xl font-heading font-bold text-slate-900 mb-2">Envie uma Mensagem</h2>
            <p class="text-xs text-slate-500 mb-6">Respondemos em até 24 horas úteis por e-mail ou WhatsApp.</p>

            <div id="contact-success-msg" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs text-center font-semibold mb-4">
              Mensagem enviada com sucesso! Nossa equipe entrará em contato em até 24 horas.
            </div>

            <form id="contact-form" class="space-y-4">
              <div>
                <label for="name" class="block text-xs font-semibold text-slate-700 mb-1">Seu Nome Completo</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors"
                  placeholder="Ex.: Juliana Silva"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">Seu Melhor E-mail</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors"
                  placeholder="exemplo@gmail.com"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-semibold text-slate-700 mb-1">Assunto</label>
                <select
                  id="subject"
                  name="subject"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors"
                >
                  <option value="duvida_matricula">Dúvida sobre matrícula ou planos</option>
                  <option value="metodologia">Dúvida sobre o Método Autêntico</option>
                  <option value="pagamento">Formas de pagamento e PIX</option>
                  <option value="outro">Outro assunto</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-xs font-semibold text-slate-700 mb-1">Sua Mensagem</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors resize-none"
                  placeholder="Como podemos te ajudar hoje?"
                ></textarea>
              </div>

              <button
                type="submit"
                class="btn-editorial-primary w-full text-center text-sm font-semibold !py-3.5"
              >
                Enviar Mensagem
              </button>
            </form>
          </div>
        </div>

        <!-- Canais Rápidos & Contatos Oficiais -->
        <div class="lg:col-span-5 flex flex-col gap-5">

          <div class="editorial-card p-6">
            <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full uppercase inline-block mb-3">
              Atendimento Ágil
            </span>
            <h3 class="text-xl font-heading font-bold text-slate-900 mb-2">WhatsApp Comercial</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Prefere tirar dúvidas pelo WhatsApp antes de se matricular? Nossa equipe de suporte está à disposição em horário comercial.
            </p>
            <a
              href="https://wa.me/5511999999999?text=Ol%C3%A1!%20Gostaria%20de%20tirar%20d%C3%BAvidas%20sobre%20o%20Fluente%20no%20Mundo"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-editorial-secondary w-full text-center text-xs font-semibold !py-3 flex items-center justify-center gap-2"
            >
              <span>Conversar no WhatsApp</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

          <div class="editorial-card p-6">
            <h3 class="text-base font-heading font-bold text-slate-900 mb-2">Para Alunos Ativos</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Se você já é aluno matriculado e precisa de suporte pedagógico em uma aula, utilize o canal exclusivo <strong>SOS Professora</strong> dentro da sua plataforma para resposta em áudio pela Prof. Amanda.
            </p>
            <a
              href="https://alunos.fluentenomundo.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-blue-700 hover:text-blue-800 font-semibold flex items-center gap-1"
            >
              Acessar SOS Professora na Área do Aluno
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <div class="editorial-card p-6">
            <h3 class="text-base font-heading font-bold text-slate-900 mb-3">Canais Oficiais</h3>
            <ul class="text-xs text-slate-600 space-y-2.5">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>
                <span><strong>YouTube:</strong> youtube.com/@fluentenomundo</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-pink-500 shrink-0"></span>
                <span><strong>Instagram:</strong> instagram.com/fluentenomundo</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>
                <span><strong>Horário:</strong> Segunda a Sexta, das 09h às 18h</span>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('contact-success-msg');
    if (form && successMsg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        successMsg.classList.remove('hidden');
        form.reset();
        setTimeout(() => {
          successMsg.classList.add('hidden');
        }, 5000);
      });
    }
  </script>

</BaseLayout>
