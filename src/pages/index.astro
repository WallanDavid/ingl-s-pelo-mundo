---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudentPlatformLab from '../components/StudentPlatformLab.astro';

const pageTitle = 'Fluente no Mundo | Uma Jornada de Idiomas que Vai Além das Aulas';
const pageDesc = 'Conheça o ecossistema Fluente no Mundo: formação estruturada, repetição espaçada em 3 etapas, aulas ao vivo semanais com a Prof. Amanda Beatriz e acompanhamento direto.';

const journeySteps = [
  {
    step: '01',
    title: 'Formação Estruturada',
    desc: 'Metas diárias organizadas em cronogramas semanais e mensais. Você sabe exatamente o que estudar a cada dia sem perder tempo.',
    detail: 'Formações Essenciais & Complementares',
  },
  {
    step: '02',
    title: 'Prática Biomecânica (4Ps)',
    desc: 'Treinamento focado em padrões fonéticos, posição da musculatura bucal e ritmo nativo (connected speech) para falar sem travar.',
    detail: 'Padrões · Pronúncia · Psicológico · Prática',
  },
  {
    step: '03',
    title: 'Revisão Espaçada Ativa (3Rs)',
    desc: 'Ciclo em três etapas (Ouvir, Pronunciar e Traduzir no contexto). Seu cérebro consolida o vocabulário no momento exato.',
    detail: 'Sistema SRS com Meta de 20.000 Expressões',
  },
  {
    step: '04',
    title: 'Imersão Cultural & Vida Real',
    desc: 'Vivência Global com séries, podcasts, filmes e músicas originais sem legendas em português, aplicando o idioma na rotina.',
    detail: 'Desafios Semanais de Aculturamento',
  },
  {
    step: '05',
    title: 'Evolução & Certificação',
    desc: 'Acompanhamento do streak diário, pontuação acumulada e emissão de certificados com carga horária comprovada a cada 3 meses.',
    detail: 'Certificados Modulares Trimestrais',
  },
];

const pillarsList = [
  { letter: 'A', name: 'Assimilação e Aculturamento', desc: 'Integração cultural profunda que elimina a tradução mental literal.' },
  { letter: 'U', name: 'União, Equilíbrio e Constância', desc: 'Harmonia entre ouvir, falar, ler e escrever em doses diárias sustentáveis.' },
  { letter: 'T', name: 'Treine os 4P', desc: 'Padrões, Pronúncia muscular, Psicológico seguro e Prática oral ativa.' },
  { letter: 'E', name: 'Emoções', desc: 'Ambiente acolhedor onde o erro é instrumento de aprendizado sem ansiedade.' },
  { letter: 'N', name: 'Neurociência 4D', desc: 'Aplicação de sinapses ativas e consolidação durante o repouso.' },
  { letter: 'T', name: 'Técnicas de Metacognição', desc: 'Autonomia para diagnosticar suas dificuldades e aprender a estudar.' },
  { letter: 'I', name: 'Input Massivo e Imersão', desc: 'Repertório sonoro contextual que antecede a análise gramatical.' },
  { letter: 'C', name: 'Conexões Autênticas', desc: 'Aplicação das expressões à sua vida, profissão e projetos pessoais.' },
  { letter: 'A', name: 'Aquisição 3R', desc: 'Revisão espaçada, Repetição contextual e Reapresentação multissensorial.' },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/"
>
  
  <!-- SEÇÃO 1: HERO EDITORIAL PRODUCT-LED -->
  <section class="pt-12 pb-20 lg:pt-20 lg:pb-28 bg-[#f8fafc] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-6">
          <span>Metodologia Autêntica · Área do Aluno</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-slate-900 tracking-tight leading-[1.15]">
          Uma jornada de idiomas que vai além das aulas.
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
          Esqueça os cursinhos genéricos baseados em decoreba mecânica. O <strong>Fluente no Mundo</strong> integra cronograma diário, repetição espaçada em 3 etapas, aulas ao vivo semanais e mentoria individual com a <strong>Prof. Amanda Beatriz</strong>.
        </p>

        <!-- Ações do Hero -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="#laboratorio-interativo"
            class="btn-editorial-primary !py-3.5 !px-6 !text-sm w-full sm:w-auto"
          >
            <span>Explorar Demonstração Interativa</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <a
            href="/metodo"
            class="btn-editorial-secondary !py-3.5 !px-6 !text-sm w-full sm:w-auto"
          >
            <span>Conhecer os 9 Pilares do Método</span>
          </a>
        </div>

        <div class="mt-8 flex items-center justify-center gap-6 text-xs text-slate-500 font-medium">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Aulas ao Vivo Semanais
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
            Canal SOS Professora em 48h
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
            Certificados Modulares a cada 3 Meses
          </span>
        </div>
      </div>

      <!-- Preview da Plataforma no Topo do Hero -->
      <div class="max-w-5xl mx-auto">
        <div class="p-2 sm:p-3 rounded-2xl bg-slate-200/80 border border-slate-300 shadow-sm">
          <div class="rounded-xl overflow-hidden bg-slate-900 border border-slate-700/60 aspect-[16/9] relative group">
            <img
              src="/images/platform/dashboard.png"
              alt="Interface do Dashboard da Plataforma do Aluno Fluente no Mundo"
              class="w-full h-full object-cover object-top"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent flex items-end p-6 sm:p-8">
              <div class="text-white max-w-xl">
                <span class="text-[11px] font-mono uppercase tracking-widest text-blue-300 bg-blue-900/60 px-2.5 py-0.5 rounded inline-block mb-2">
                  Ambiente Oficial do Estudante
                </span>
                <h3 class="text-lg sm:text-2xl font-heading font-bold text-white">
                  O painel diário onde a sua rotina acontece
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 mt-1">
                  Mapa de foco semanal, polyglot check, desafio diário de vocabulário e recados ao vivo da professora.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- SEÇÃO 2: VEJA COMO FUNCIONA (O LABORATÓRIO INTERATIVO COMPLETO) -->
  <section id="laboratorio-interativo" class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="badge-subtle mb-3">Laboratório de Demonstração</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 tracking-tight">
          Experimente as Ferramentas da Plataforma
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
          Navegue abaixo pelo simulador funcional desenvolvido a partir das evidências reais documentadas nos 16 PDFs da área interna do aluno.
        </p>
      </div>

      <!-- O COMPONENTE DO LABORATÓRIO INTERATIVO -->
      <StudentPlatformLab />

      <div class="mt-8 text-center">
        <p class="text-xs text-slate-500">
          Deseja uma visão aprofundada de cada tela da plataforma? 
          <a href="/plataforma" class="text-blue-700 hover:text-blue-800 font-semibold underline ml-1">
            Acessar o guia completo da experiência do aluno &rarr;
          </a>
        </p>
      </div>

    </div>
  </section>

  <!-- SEÇÃO 3: SUA JORNADA DE APRENDIZAGEM (TIMELINE EDITORIAL) -->
  <section class="py-20 bg-[#f8fafc] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-14">
        <span class="badge-neutral mb-3">Ciclo Pedagógico</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 tracking-tight">
          Como a fluência é construída na prática
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base">
          Um método progressivo que substitui listas aleatórias por um fluxo de assimilação em cinco etapas fundamentadas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        {journeySteps.map((step) => (
          <div class="editorial-card p-6 flex flex-col justify-between relative bg-white">
            <div>
              <span class="text-xs font-mono font-bold text-blue-700 bg-blue-50 px-2 py-1 rounded inline-block mb-4">
                {step.step}
              </span>
              <h3 class="text-lg font-heading font-bold text-slate-900 mb-2">
                {step.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                {step.desc}
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 text-[11px] font-semibold text-slate-500">
              {step.detail}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SEÇÃO 4: FERRAMENTAS REAIS DA PLATAFORMA (COMPOSIÇÃO EDITORIAL) -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="badge-subtle mb-3">Recursos Documentados</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 tracking-tight">
          As Quatro Ferramentas Centrais do Aluno
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
          Cada recurso foi desenhado para resolver um obstáculo real: falta de tempo, esquecimento de vocabulário, vergonha de falar e desmotivação.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        
        <!-- Recurso 1: Formação Global & Cronograma -->
        <div class="editorial-card p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full">
                Organização Diária
              </span>
              <span class="text-xs text-slate-400">PDF: Courses</span>
            </div>
            <h3 class="text-2xl font-heading font-bold text-slate-900 mb-3">
              Formação Global & Cronograma Unificado
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              O aluno é conduzido por formações essenciais (obrigatórias para a base) e formações complementares. A cada semana, as metas são divididas em doses diárias de 20 minutos com calendário único.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700">
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Foco diário guiado: saiba exatamente qual aula assistir hoje</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Trilhas de Pronúncia, Viagens, Expressão e Gramática Natural</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Certificados modulares com carga horária comprovada a cada 3 meses</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-100">
            <a href="/formacao-global" class="text-xs font-bold text-blue-700 hover:text-blue-800 flex items-center gap-1.5">
              <span>Ver grade curricular completa das formações</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Recurso 2: Vocabulário & Revisão SRS -->
        <div class="editorial-card p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full">
                Memória Ativa
              </span>
              <span class="text-xs text-slate-400">PDF: Vocabulary & Revisão</span>
            </div>
            <h3 class="text-2xl font-heading font-bold text-slate-900 mb-3">
              Vocabulário Ativo & Revisão SRS (3 Etapas)
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              A curva de esquecimento é superada por um algoritmo que agenda revisões nos intervalos exatos, exigindo que o aluno passe por três etapas: Ouvir a pronúncia nativa, Articular os sons dos 4Ps e Traduzir no contexto.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700">
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Banco pessoal de expressões integrado automaticamente às aulas</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Rastreamento rumo à meta de 20.000 expressões para fluência</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Eliminação definitiva de listas de decoreba sem uso prático</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-100">
            <a href="/plataforma" class="text-xs font-bold text-blue-700 hover:text-blue-800 flex items-center gap-1.5">
              <span>Testar a revisão em 3 etapas no laboratório</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Recurso 3: Vivência Global -->
        <div class="editorial-card p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full">
                Aculturamento Real
              </span>
              <span class="text-xs text-slate-400">PDF: Vivência Global</span>
            </div>
            <h3 class="text-2xl font-heading font-bold text-slate-900 mb-3">
              Vivência Global & Séries da Vida Real
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              O inglês não vive em livros acadêmicos. O módulo de Vivência Global conecta os estudos a filmes, séries, podcasts e músicas com desafios semanais guiados para você entender o humor, as gírias e o ritmo de rua.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700">
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Desafios semanais de consumo sem legendas em português</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Podcasts de conversas reais de nativos em situações comuns</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Compreensão de referências culturais que nenhuma gramática ensina</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-100">
            <a href="/idiomas" class="text-xs font-bold text-blue-700 hover:text-blue-800 flex items-center gap-1.5">
              <span>Conhecer os módulos culturais e a Jornada Poliglota</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Recurso 4: Conquista & Constância -->
        <div class="editorial-card p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full">
                Sustentação de Hábitos
              </span>
              <span class="text-xs text-slate-400">PDF: Conquista Constância</span>
            </div>
            <h3 class="text-2xl font-heading font-bold text-slate-900 mb-3">
              Conquista & Constância (Gamificação com Propósito)
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              A neurociência comprova que a consistência precisa de feedback positivo. A plataforma registra seus dias ativos de estudo, streaks ininterruptos e metas mensais, mantendo seu compromisso ativo sem pressão punitiva.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-700">
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Check-in diário com pontuação cumulativa (+10 pts por dia ativo)</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Badges que celebram a disciplina real e horas de exposição</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Metas trimestrais alinhadas à emissão dos certificados oficiais</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-100">
            <a href="/plataforma" class="text-xs font-bold text-blue-700 hover:text-blue-800 flex items-center gap-1.5">
              <span>Simular seu check-in no painel da plataforma</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SEÇÃO 5: EXPERIÊNCIA HUMANA (PROFESSORA, AULAS AO VIVO E SOS) -->
  <section class="py-20 bg-[#f8fafc] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5">
          <div class="p-3 bg-white border border-slate-200 rounded-2xl shadow-sm">
            <div class="aspect-[4/5] rounded-xl overflow-hidden bg-slate-100">
              <img
                src="/images/about me.png"
                alt="Professora Amanda Beatriz"
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
            </div>
            <div class="mt-3 p-3 text-center">
              <strong class="text-slate-900 block font-heading text-base">Amanda Beatriz</strong>
              <span class="text-xs text-slate-500">Mentora, Fundadora e Criadora do Método Autêntico</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6">
          <span class="badge-neutral">Presença e Mentoria Real</span>
          <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 tracking-tight leading-tight">
            Você não estuda sozinho diante de vídeos anônimos.
          </h2>
          
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Em muitas plataformas digitais, o aluno é apenas um número em um banco de dados. No <strong>Fluente no Mundo</strong>, a professora fundadora está ativamente presente na sua rotina em dois momentos decisivos:
          </p>

          <div class="space-y-4 pt-2">
            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
              <div class="flex items-center justify-between mb-1">
                <strong class="text-slate-900 text-sm font-heading font-bold">1. Aulas ao Vivo Semanais (Quartas-feiras)</strong>
                <span class="text-[11px] font-mono font-semibold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">Toda Quarta às 20h</span>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Encontros práticos e ao vivo dedicados à desmistificação de regras, prática de padrões fonéticos dos 4Ps e dinâmicas de conversação. Todas as sessões são gravadas e integradas ao acervo da plataforma.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
              <div class="flex items-center justify-between mb-1">
                <strong class="text-slate-900 text-sm font-heading font-bold">2. Canal Exclusivo SOS Professora</strong>
