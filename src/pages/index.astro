---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformShowcase from '../components/PlatformShowcase.astro';
import TestimonialsShowcase from '../components/TestimonialsShowcase.astro';
import BonusShowcase from '../components/BonusShowcase.astro';
import PricingCard from '../components/PricingCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const pageTitle = 'Fluente no Mundo | Fale Inglês com Naturalidade com a Prof. Amanda Beatriz';
const pageDesc = 'Aprenda a falar inglês com naturalidade, sem travar e sem decoreba. Aulas ao vivo semanais, repetição espaçada em 3 etapas, mentoria com a Prof. Amanda Beatriz e planos a partir de R$ 39,90/mês.';

const targetProfiles = [
  {
    icon: 'speaker',
    title: 'Para quem trava na hora de falar',
    desc: 'Você entende bem o que ouve e lê, mas na hora de responder em inglês dá um branco, a voz falha e o medo do julgamento trava sua boca.',
    solution: 'O Treinamento 4P destrava os músculos da fala e constrói segurança psicológica real.'
  },
  {
    icon: 'briefcase',
    title: 'Para quem precisa crescer na carreira',
    desc: 'Perdeu oportunidades de promoção, tem pavor de reuniões globais ou precisa se preparar para entrevistas de emprego em inglês com urgência.',
    solution: 'Vocabulário corporativo prático, connected speech e simulação de cenários profissionais.'
  },
  {
    icon: 'globe',
    title: 'Para viajantes que querem independência',
    desc: 'Quer viajar pelo mundo, passar pela imigração, fazer pedidos em restaurantes e conversar com nativos sem depender de tradutores no celular.',
    solution: 'Inglês da vida real: situações cotidianas, gírias e pronúncia clara para qualquer país.'
  },
  {
    icon: 'sparkles',
    title: 'Para quem cansou de cursinhos tradicionais',
    desc: 'Passou anos pagando mensalidades caras de R$ 400 em escolas tradicionais e só aprendeu regras gramaticais chatas sem falar nada.',
    solution: 'Dose diária de 20 minutos focada em assimilação natural, sem listas mecânicas de decoreba.'
  }
];

const homeFaqs = [
  {
    question: 'Como funciona o acesso à plataforma e às aulas?',
    answer: 'Assim que sua matrícula for confirmada, você recebe imediatamente no seu e-mail os dados de acesso à plataforma do aluno. Você pode estudar pelo computador, tablet ou celular, no horário que for mais conveniente para a sua rotina.'
  },
  {
    question: 'Eu nunca estudei inglês antes. O método serve para quem está no zero?',
    answer: 'Com certeza! O Método A.U.T.E.N.T.I.C.A foi desenvolvido exatamente para acolher desde quem nunca falou uma palavra até quem já tem vocabulário mas trava na hora de falar. Você começa pelas Formações Essenciais no seu próprio ritmo.'
  },
  {
    question: 'Quanto tempo por dia preciso dedicar para ter resultados?',
    answer: 'Apenas 20 minutos diários de estudo focado são suficientes. Nosso cronograma inteligente divide o conteúdo em micro-metas diárias que cabem na rotina mais corrida, sem sobrecarga mental.'
  },
  {
    question: 'Como funcionam as aulas ao vivo de quarta-feira com a Prof. Amanda?',
    answer: 'Todas as quartas-feiras, às 20h, Amanda entra ao vivo em uma sessão interativa para desmistificar pronúncia, praticar conversação e responder dúvidas da turma. Se você não puder assistir ao vivo, a gravação completa fica disponível na plataforma no dia seguinte.'
  },
  {
    question: 'Como funciona a garantia incondicional de 7 dias?',
    answer: 'Você tem 7 dias corridos para acessar a plataforma, assistir às aulas e participar da aula ao vivo. Se por qualquer motivo achar que o curso não atende às suas expectativas, basta solicitar o reembolso com um clique e devolvemos 100% do seu valor.'
  },
  {
    question: 'Posso cancelar a assinatura mensal quando quiser?',
    answer: 'Sim! No Plano Mensal (R$ 39,90/mês), você não tem fidelidade nem multas rescisórias. É uma assinatura simples, como um serviço de streaming, e você tem controle total para cancelar quando quiser.'
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/"
>
  
  <!-- SEÇÃO 1: HERO COMERCIAL DE ALTA CONVERSÃO -->
  <section class="pt-10 pb-20 lg:pt-16 lg:pb-28 bg-[#f8fafc] border-b border-slate-200 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- COLUNA DA ESQUERDA: COPY PERSUASIVA & CTAs -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold uppercase tracking-wider shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Matrículas Abertas · Acesso Imediato</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-slate-900 tracking-tight leading-[1.12]">
            Fale inglês com a naturalidade de um nativo — <span class="text-blue-700">sem travar e sem vergonha.</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
            Esqueça a decoreba de gramática mecânica. O <strong>Fluente no Mundo</strong> combina neurociência cognitiva, repetição espaçada inteligente, aulas ao vivo semanais com a <strong>Prof. Amanda Beatriz</strong> e mentoria direta para você falar inglês com confiança.
          </p>

          <!-- PROVA SOCIAL RÁPIDA NO HERO -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs font-semibold text-slate-600">
            <div class="flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-lg border border-slate-200 shadow-sm">
              <div class="flex text-amber-500">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              </div>
              <span class="text-slate-900 font-bold">4.9/5</span>
              <span class="text-slate-500">(+10.000 alunos)</span>
            </div>

            <div class="flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-lg border border-slate-200 shadow-sm text-emerald-700">
              <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span>7 Dias de Garantia Total</span>
            </div>
          </div>

          <!-- BOTÕES DE AÇÃO HERO -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <a
              href="#planos"
              class="btn-editorial-primary !py-4 !px-8 !text-sm w-full sm:w-auto text-center !bg-blue-700 hover:!bg-blue-800 shadow-xl shadow-blue-900/20 flex items-center justify-center gap-2"
            >
              <span>Quero Começar Agora</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href="#plataforma-tour"
              class="btn-editorial-secondary !py-4 !px-6 !text-sm w-full sm:w-auto text-center flex items-center justify-center gap-2"
            >
              <span>Ver Plataforma por Dentro</span>
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
          </div>

          <div class="pt-1 text-xs text-slate-500">
            <span>Apenas R$ 39,90/mês no plano flexível · Cancele quando quiser</span>
          </div>

        </div>

        <!-- COLUNA DA DIREITA: COMPOSIÇÃO VISUAL COM FOTO DE AMANDA E PLATAFORMA -->
        <div class="lg:col-span-5 relative">
          
          <div class="relative mx-auto max-w-md lg:max-w-none">
            
            <!-- Foto de Amanda Beatriz em Card Elevado -->
            <div class="relative z-10 rounded-3xl overflow-hidden bg-slate-900 border-4 border-white shadow-2xl">
              <div class="aspect-[4/5] relative">
                <img
                  src="/images/about me.png"
                  alt="Professora Amanda Beatriz - Criadora do Método Fluente no Mundo"
                  class="w-full h-full object-cover object-top"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent flex items-end p-6">
                  <div class="text-white">
                    <span class="text-[10px] uppercase font-bold tracking-widest text-blue-300 bg-blue-950/80 px-2.5 py-1 rounded inline-block mb-1 border border-blue-500/30">
                      Sua Mentora de Fluência
                    </span>
                    <h3 class="text-xl font-heading font-bold text-white">
                      Amanda Beatriz
                    </h3>
                    <p class="text-xs text-slate-300 mt-0.5">
                      "O inglês não é sobre regras perfeitas. É sobre liberdade para ser você em qualquer lugar do mundo."
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Flutuante 1: Aula ao Vivo Toda Quarta -->
            <div class="absolute -bottom-6 -left-6 z-20 p-4 rounded-2xl bg-white border border-slate-200 shadow-xl max-w-[220px] hidden sm:block animate-bounce-subtle">
              <div class="flex items-center gap-2 mb-1">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-rose-600">Ao Vivo</span>
              </div>
              <strong class="text-xs text-slate-900 block font-heading">Toda Quarta às 20h</strong>
              <p class="text-[10px] text-slate-500 mt-0.5">
                Treino de fala prático e correção direta com Amanda.
              </p>
            </div>

            <!-- Card Flutuante 2: Plataforma em Uso Real -->
            <div class="absolute -top-6 -right-6 z-20 p-3 rounded-2xl bg-white border border-slate-200 shadow-xl max-w-[200px] hidden sm:block">
              <div class="aspect-video rounded-lg overflow-hidden bg-slate-950 mb-2 border border-slate-100">
                <img
                  src="/images/cafe com plataforma.jpg"
                  alt="Estudando na plataforma do aluno"
                  class="w-full h-full object-cover"
                  loading="eager"
                />
              </div>
              <span class="text-[10px] font-semibold text-slate-700 block">Estude onde quiser</span>
              <span class="text-[9px] text-slate-400">20 minutos diários guiados</span>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- BARRA DE MÉTIRICAS E PILARES DE CONFIANÇA -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <span class="text-3xl sm:text-4xl font-heading font-black text-blue-700 block">
            +10.000
          </span>
          <span class="text-xs font-bold text-slate-800 uppercase tracking-wider block mt-1">
            Alunos Impactados
          </span>
          <span class="text-[11px] text-slate-500 mt-0.5 block">
            Pessoas reais falando sem medo
          </span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <span class="text-3xl sm:text-4xl font-heading font-black text-purple-700 block">
            Toda 4ª
          </span>
          <span class="text-xs font-bold text-slate-800 uppercase tracking-wider block mt-1">
            Aulas ao Vivo às 20h
          </span>
          <span class="text-[11px] text-slate-500 mt-0.5 block">
            Prática direta com a fundadora
          </span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <span class="text-3xl sm:text-4xl font-heading font-black text-emerald-700 block">
            4Ps
          </span>
          <span class="text-xs font-bold text-slate-800 uppercase tracking-wider block mt-1">
            Treino Biomecânico
          </span>
          <span class="text-[11px] text-slate-500 mt-0.5 block">
            Fim do sotaque travado
          </span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <span class="text-3xl sm:text-4xl font-heading font-black text-amber-600 block">
            7 Dias
          </span>
          <span class="text-xs font-bold text-slate-800 uppercase tracking-wider block mt-1">
            Garantia Incondicional
          </span>
          <span class="text-[11px] text-slate-500 mt-0.5 block">
            Risco zero absoluto para testar
          </span>
        </div>

      </div>
    </div>
  </section>

  <!-- SEÇÃO 2: PARA QUEM É O FLUENTE NO MUNDO (IDENTIFICAÇÃO DAS DORES) -->
  <section class="py-20 bg-[#f8fafc] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="badge-subtle mb-4">Você se Identifica?</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-slate-900 tracking-tight leading-tight mt-3">
          O método feito sob medida para destravar sua voz
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          Se você se enxerga em qualquer um dos cenários abaixo, o Fluente no Mundo foi desenhado especificamente para você:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {targetProfiles.map((p) => (
          <div class="editorial-card p-6 bg-white flex flex-col justify-between border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all">
            <div>
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-sm mb-4">
                <svg class="w-5 h-5 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              </div>
              <h3 class="text-lg font-heading font-bold text-slate-900 mb-2">
                {p.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                {p.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100">
              <span class="text-[11px] font-semibold text-emerald-700 block">
                Como a escola resolve:
              </span>
              <p class="text-[11px] text-slate-500 mt-0.5">
                {p.solution}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="#planos"
          class="btn-editorial-primary !py-3.5 !px-8 text-xs inline-flex items-center gap-2"
        >
          <span>Quero Destravar Minha Fluência &rarr;</span>
        </a>
      </div>

    </div>
  </section>

  <!-- SEÇÃO 3: SHOWCASE DA PLATAFORMA POR DENTRO (COM IMAGENS REAIS E ABAS FLUIDAS) -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PlatformShowcase />
    </div>
  </section>

  <!-- SEÇÃO 4: DEPOIMENTOS REAIS DOS ALUNOS (PROVA SOCIAL COM IMAGENS REAIS) -->
  <TestimonialsShowcase />

  <!-- SEÇÃO 5: A MENTORA AMANDA BEATRIZ -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5">
          <div class="p-3 bg-[#f8fafc] border border-slate-200 rounded-3xl shadow-sm">
            <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-slate-900 relative">
              <img
                src="/images/about me.png"
                alt="Professora Amanda Beatriz"
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
            </div>
            <div class="mt-4 p-2 text-center">
              <strong class="text-slate-900 block font-heading text-lg font-bold">Amanda Beatriz</strong>
              <span class="text-xs text-slate-500">Mentora, Fundadora e Criadora do Método Autêntico</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6">
          <span class="badge-subtle">Quem Estará com Você</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-slate-900 tracking-tight leading-tight">
            "Eu também já travei. E descobri que o problema nunca foi você."
          </h2>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Durante anos, o ensino de inglês no Brasil fez as pessoas acreditarem que não tinham o "dom" para idiomas. Mas a verdade é outra: métodos ultrapassados ensinam gramática mecânica e cobram perfeição imediata, gerando ansiedade e vergonha.
          </p>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            No <strong>Fluente no Mundo</strong>, criei um ecossistema seguro onde você erra sem medo, treina a musculatura da boca com os 4Ps, expande seu vocabulário em doses de 20 minutos e conta comigo toda semana nas aulas ao vivo e no canal SOS individual.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row gap-4 items-stretch sm:items-center">
            <a href="#planos" class="btn-editorial-primary !py-3.5 !px-6 !text-xs text-center">
              Quero Estudar com a Amanda Beatriz &rarr;
            </a>
            <a href="/sobre" class="text-xs font-bold text-slate-700 hover:text-slate-900 underline text-center sm:text-left">
              Ler a trajetória completa da professora
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- SEÇÃO 6: BÔNUS EXCLUSIVOS DE MATRÍCULA -->
  <BonusShowcase />

  <!-- SEÇÃO 7: PLANOS E MATRÍCULA COMERCIAL -->
  <PricingCard />

  <!-- SEÇÃO 8: PERGUNTAS FREQUENTES COMERCIAIS -->
  <FaqAccordion
    items={homeFaqs}
    title="Dúvidas Frequentes sobre o Curso"
    subtitle="Tudo o que você precisa saber antes de dar o passo rumo à sua liberdade em inglês."
  />

  <!-- SEÇÃO 9: CTA FINAL DE FECHAMENTO ESTIMULANTE -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-blue-900 via-slate-900 to-slate-950 text-white text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
