---
// src/pages/index.astro
// Fluente no Mundo — Recriação Oficial Completa (Product-Led, Interativo, Estilo Viagem do Lead)
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVoyage from '../components/HeroVoyage.astro';
import InteractiveComparison from '../components/InteractiveComparison.astro';
import MethodAuthentic from '../components/MethodAuthentic.astro';
import PlatformSimulator from '../components/PlatformSimulator.astro';
import LeadJourneySimulator from '../components/LeadJourneySimulator.astro';
import OfficialPricing from '../components/OfficialPricing.astro';
import FaqOfficial from '../components/FaqOfficial.astro';

const pageTitle = 'Fluente no Mundo | Fale Inglês com a Prof. Amanda Beatriz';
const pageDesc = 'Sua viagem para falar inglês com naturalidade e liberdade. Conheça a Metodologia Autêntica, os 4Ps da pronúncia e explore os 15 produtos integrados da plataforma oficial.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/"
>

  <!-- HERO INTERATIVO: A VIAGEM DO LEAD + PASSAPORTE DINÂMICO -->
  <HeroVoyage />

  <!-- ESTAÇÃO 1: COMPARATIVO DE ROTAS + GRÁFICO DE MEMÓRIA + CALCULADORA DE ECONOMIA -->
  <InteractiveComparison />

  <!-- ESTAÇÃO 2: OS MÉTODOS DA PROF. AMANDA BEATRIZ (4Ps + MATRIZ A.U.T.E.N.T.I.C.A INTERATIVA) -->
  <MethodAuthentic />

  <!-- ESTAÇÃO 3: A PLATAFORMA REAL DOS ALUNOS (COM O PRINT ANEXADO E PREVIEW DOS 15 PRODUTOS) -->
  <PlatformSimulator />

  <!-- ESTAÇÃO 4: SIMULADOR DE PLANO DE VOO DO LEAD (ROTEIRO PERSONALIZADO) -->
  <LeadJourneySimulator />

  <!-- ESTAÇÃO 5: PLANOS OFICIAIS (R$ 39,90 & R$ 179,40) + MODAL DE PAGAMENTO FUNCIONAL (CARTÃO / PIX) -->
  <OfficialPricing />

  <!-- PERGUNTAS FREQUENTES OFICIAIS (SEM DEPOIMENTOS) -->
  <FaqOfficial />

  <!-- CTA DE FECHAMENTO COMERCIAL DA VIAGEM -->
  <section class="py-20 lg:py-24 bg-gradient-to-b from-[#070812] via-[#0d0f24] to-[#040408] text-center relative overflow-hidden border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff]">
        <span>Pronto para Decolar?</span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-serif text-white tracking-tight leading-tight">
        Seu passaporte para a fluência está a <br />
        <em class="italic font-normal text-[#c8c2ff]">um clique de distância.</em>
      </h2>

      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed font-sans">
        Viaje com segurança, participe de reuniões em inglês e converse com nativos sem medo. Teste por 7 dias com risco zero e tenha acesso a todos os 15 produtos.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#planos"
          class="btn-white-luxury w-full sm:w-auto px-9 py-4 text-xs uppercase tracking-wider shadow-2xl flex items-center justify-center gap-2"
        >
          <span>Garantir Matrícula Agora</span>
          <svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <a
          href="https://alunos.fluentenomundo.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost-cosmic w-full sm:w-auto px-7 py-4 text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Acessar Plataforma de Alunos</span>
        </a>
      </div>

      <p class="text-xs text-slate-400 pt-2 font-sans">
        Garantia total de 7 dias · Cancele quando quiser · Sem contratos abusivos
      </p>

    </div>
  </section>

  <!-- BARRA FIXA MOBILE DE CONVERSÃO (EXPERIÊNCIA MOBILE PRIMÁRIA) -->
  <aside class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#090a16]/95 backdrop-blur-xl border-t border-white/15 p-3 px-4 flex items-center justify-between shadow-2xl" aria-label="Ação rápida de matrícula">
    <div class="space-y-0.5">
      <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider block">Fluente no Mundo</span>
      <div class="text-xs font-bold text-white">
        A partir de <span class="text-emerald-400 font-extrabold">R$ 39,90/mês</span>
      </div>
    </div>
    <a
      href="#planos"
      class="btn-white-luxury px-5 py-2.5 text-[11px] uppercase tracking-wider shadow-md"
    >
      Embarcar
    </a>
  </aside>

</BaseLayout>
