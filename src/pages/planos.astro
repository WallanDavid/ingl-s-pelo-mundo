---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingCard from '../components/PricingCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const pageTitle = 'Planos e Matrícula | Fluente no Mundo - A partir de R$ 39,90/mês';
const pageDesc = 'Matricule-se no Fluente no Mundo por apenas R$ 39,90/mês. Aulas ao vivo semanais, SOS Professora em 48h, repetição espaçada e garantia de 7 dias.';

const pricingFaqs = [
  {
    question: 'Como funciona a cobrança da assinatura mensal de R$ 39,90?',
    answer: 'A assinatura mensal é debitada automaticamente no seu cartão de crédito a cada 30 dias, como uma assinatura de streaming. Você não compromete o limite total do cartão com um valor anual elevado e pode cancelar a qualquer momento sem multas.',
  },
  {
    question: 'Posso pagar por PIX?',
    answer: 'Sim! Aceitamos PIX para o plano anual à vista com desconto especial, garantindo liberação imediata do seu acesso à plataforma.',
  },
  {
    question: 'Como solicito o reembolso caso eu não me adapte nos primeiros 7 dias?',
    answer: 'É simples e sem constrangimento. Basta entrar em contato com nossa equipe pela própria plataforma ou pelo suporte de e-mail/WhatsApp dentro do prazo de 7 dias e o reembolso integral será processado imediatamente.',
  },
  {
    question: 'O plano mensal inclui mesmo as aulas ao vivo com a Prof. Amanda?',
    answer: 'Sim! Todos os alunos matriculados, sejam do plano mensal ou anual, têm acesso garantido às aulas ao vivo semanais às quartas-feiras e ao acervo completo de gravações.',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/planos"
>
  
  <!-- CABEÇALHO DA PÁGINA -->
  <section class="pt-12 pb-16 bg-[#f8fafc] border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="badge-subtle mb-4">Escolha o Seu Plano</span>
      <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-slate-900 tracking-tight leading-tight mt-3">
        Invista na sua fluência real
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
        Acesso completo à plataforma, cronogramas diários, aulas ao vivo semanais e mentoria individual com a Prof. Amanda Beatriz.
      </p>
    </div>
  </section>

  <!-- CARDS DE PLANOS -->
  <PricingCard />

  <!-- SELOS DE SEGURANÇA E FORMAS DE PAGAMENTO -->
  <section class="py-12 border-b border-slate-200 bg-[#f8fafc]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs uppercase font-bold tracking-widest text-slate-400 block mb-6">
        Formas de Pagamento Seguras e Homologadas
      </span>
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-sm">
        <div class="flex items-center gap-2 text-slate-600">
          <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <strong class="text-slate-900">PIX Instantâneo</strong>
        </div>
        <div class="flex items-center gap-2 text-slate-600">
          <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
          <strong class="text-slate-900">Cartão de Crédito</strong>
        </div>
        <div class="flex items-center gap-2 text-slate-600">
          <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <strong class="text-slate-900">Boleto Bancário</strong>
        </div>
        <div class="flex items-center gap-2 text-emerald-700">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <strong>Checkout Criptografado SSL</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ DE PREÇOS -->
  <FaqAccordion
    items={pricingFaqs}
    title="Dúvidas sobre Matrícula e Pagamento"
    subtitle="Esclarecimentos transparentes para você se matricular com total segurança."
  />

</BaseLayout>
