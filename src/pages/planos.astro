---
// src/pages/planos.astro
// Página Oficial de Planos & Investimento
import BaseLayout from '../layouts/BaseLayout.astro';
import OfficialPricing from '../components/OfficialPricing.astro';
import FaqOfficial from '../components/FaqOfficial.astro';

const pageTitle = 'Planos e Investimento | Fluente no Mundo - A partir de R$ 39,90/mês';
const pageDesc = 'Matricule-se na Formação Global da Prof. Amanda Beatriz por apenas R$ 39,90/mês no plano flexível ou R$ 179,40 no semestral. Aulas ao vivo e 15 produtos inclusos.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/planos"
>
  
  <!-- CABEÇALHO DA PÁGINA -->
  <section class="pt-16 pb-12 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff]">
        <span>Valores Oficiais · fluentenomundo.com</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-serif text-white tracking-tight leading-tight">
        Escolha o seu plano de <em class="italic font-normal text-[#c8c2ff]">transformação.</em>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
        Acesso completo aos 15 produtos, aulas ao vivo semanais com a Prof. Amanda Beatriz e suporte direto no SOS Professora.
      </p>
    </div>
  </section>

  <!-- SEÇÃO DE PLANOS OFICIAIS COM CHECKOUT MODAL FUNCIONAL -->
  <OfficialPricing />

  <!-- FAQ -->
  <FaqOfficial />

</BaseLayout>
