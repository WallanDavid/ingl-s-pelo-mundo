---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Metodologia A.U.T.E.N.T.I.C.A | Os 9 Pilares da Fluência Real';
const pageDesc = 'Conheça em detalhes os 9 pilares da Metodologia Autêntica: Neurociência 4D, Treinamento 4P, Aquisição 3R, Metacognição e Aculturamento para falar inglês sem medo.';

const pillarsDetail = [
  {
    letter: 'A',
    name: 'Assimilação e Aculturamento',
    lead: 'O idioma é inseparável da cultura de quem o fala.',
    bullets: [
      'Superação da tradução literal que gera falas robóticas.',
      'Compreensão de referências culturais, humor e nuances de comunicação nativa.',
      'Integração de conteúdos audiovisuais da vida real desde a primeira semana.',
    ],
  },
  {
    letter: 'U',
    name: 'União, Equilíbrio e Constância',
    lead: 'Harmonia entre ouvir, falar, ler e escrever.',
    bullets: [
      'Eliminação do desequilíbrio comum de quem "entende tudo, mas trava na hora de falar".',
      'Doses diárias de 15 a 30 minutos de estudo sustentável que cabem em qualquer rotina.',
      'Prevenção do esgotamento e da desistência típica de cursinhos extensos.',
    ],
  },
  {
    letter: 'T',
    name: 'Treine os 4P',
    lead: 'O treinamento focado para a mecânica da fala.',
    bullets: [
      'Padrões: Reconhecimento imediato de conexões sonoras comuns (connected speech).',
      'Pronúncia: Exercícios musculares para sons inexistentes no português (como o "th" e vogais curtas).',
      'Psicológico: Técnicas para controlar o julgamento interno e a vergonha de errar.',
      'Prática: Treino oral ativo com repetição e gravação da própria voz.',
    ],
  },
  {
    letter: 'E',
    name: 'Emoções',
    lead: 'A segurança emocional como pré-requisito da memória.',
    bullets: [
      'Ambiente acolhedor onde o erro é compreendido como dado essencial de aprendizagem.',
      'Estratégias de relaxamento e confiança para situações de pressão (entrevistas, viagens, reuniões).',
      'Estudo associado a sensações positivas de conquista e evolução contínua.',
    ],
  },
  {
    letter: 'N',
    name: 'Neurociência 4D',
    lead: 'Como o cérebro humano consolida uma nova língua.',
    bullets: [
      'Aproveitamento da neuroplasticidade através de estímulos multissensoriais.',
      'Foco na consolidação sináptica durante os intervalos de descanso.',
      'Estratégias de atenção plena para focar nos padrões que realmente importam.',
    ],
  },
  {
    letter: 'T',
    name: 'Técnicas de Metacognição',
    lead: 'Aprender a aprender e dominar seus próprios processos mentais.',
    bullets: [
      'Diagnóstico autônomo dos seus pontos fortes e fracos na língua.',
      'Personalização das estratégias de revisão para seu estilo cognitivo predominante.',
      'Independência permanente de métodos prontos.',
    ],
  },
  {
    letter: 'I',
    name: 'Input Massivo e Imersão',
    lead: 'Ouvido treinado antes de uma fala forçada.',
    bullets: [
      'Exposição contextualizada a podcasts, trechos de filmes e conversas naturais.',
      'Construção de um repertório sonoro intuitivo que antecede a análise gramatical.',
      'Masterclasses imersivas semanais com condução prática da professora.',
    ],
  },
  {
    letter: 'C',
    name: 'Conexões Autênticas',
    lead: 'Vocabulário ancorado na sua identidade.',
    bullets: [
      'Aplicação de novas expressões aos seus interesses reais, profissão e projetos pessoais.',
      'Conversas contextualizadas que substituem diálogos artificiais de livros escolares.',
      'Conexão com a comunidade de alunos para prática colaborativa.',
    ],
  },
  {
    letter: 'A',
    name: 'Aquisição 3R',
    lead: 'Revisão · Repetição · Reapresentação.',
    bullets: [
      'Revisão: Intervalos matematicamente programados pela curva do esquecimento (SRS).',
      'Repetição: Uso repetido de expressões em novos contextos de frase.',
      'Reapresentação: O mesmo conceito reintroduzido em formatos variados (áudio, texto, vídeo e quiz).',
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/metodo"
>
  
  <!-- CABEÇALHO DA PÁGINA -->
  <section class="py-16 sm:py-20 relative border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>📖 Fundamento Pedagógico</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-heading font-black text-white tracking-tight leading-tight">
        A Metodologia <span class="gradient-text-indigo">A.U.T.E.N.T.I.C.A</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Criada pela <strong>Prof. Amanda Beatriz</strong>, esta abordagem integra neurociência cognitiva, segurança emocional e aculturamento real para transformar qualquer pessoa em um falante confiante de inglês.
      </p>
    </div>
  </section>

  <!-- OS 4P E OS 3R EM DETALHE -->
  <section class="py-16 bg-[#070b16]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <div class="glass-card p-8 rounded-3xl border border-indigo-500/30">
          <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest bg-indigo-500/20 px-3 py-1 rounded-full inline-block mb-4">
            Pilares da Fala
          </span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-white mb-3">
            O Treinamento 4P
          </h2>
          <p class="text-sm text-slate-300 mb-6 leading-relaxed">
            Por que você trava mesmo sabendo a regra de cabeça? Porque a fala não é um processo apenas intelectual, é neuro-muscular.
          </p>
          <div class="space-y-4">
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <strong class="text-indigo-300 block text-sm">1. Padrões Sonoros</strong>
              <span class="text-xs text-slate-300">Como as palavras se conectam na fala rápida nativa (ex.: "wanna", "gonna", elisões e linkings).</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <strong class="text-indigo-300 block text-sm">2. Pronúncia Física</strong>
              <span class="text-xs text-slate-300">Treinamento específico de língua, lábios e palato para os sons característicos do inglês.</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <strong class="text-indigo-300 block text-sm">3. Psicológico Blindado</strong>
              <span class="text-xs text-slate-300">Desarmar a autocobrança excessiva que bloqueia sua fala quando você precisa se comunicar.</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <strong class="text-indigo-300 block text-sm">4. Prática Direcionada</strong>
              <span class="text-xs text-slate-300">Falar em voz alta, gravar sua voz e comparar diretamente com a professora.</span>
            </div>
          </div>
        </div>

        <div class="glass-card p-8 rounded-3xl border border-teal-500/30">
          <span class="text-xs font-bold text-teal-400 uppercase tracking-widest bg-teal-500/20 px-3 py-1 rounded-full inline-block mb-4">
            Retenção de Longo Prazo
          </span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-white mb-3">
            O Ciclo de Aquisição 3R
          </h2>
          <p class="text-sm text-slate-300 mb-6 leading-relaxed">
            O cérebro descarta informações que não parecem vitais. O ciclo 3R engana a curva do esquecimento de Ebbinghaus.
          </p>
          <div class="space-y-4">
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <strong class="text-teal-300 block text-sm">1. Revisão Espaçada (SRS)</strong>
              <span class="text-xs text-slate-300">Intervalos matemáticos (1 dia, 3 dias, 7 dias, 21 dias) acionados na plataforma.</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <strong class="text-teal-300 block text-sm">2. Repetição Contextual</strong>
              <span class="text-xs text-slate-300">Nunca repetir como papagaio, mas sim usar a expressão em frases da sua própria vida.</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <strong class="text-teal-300 block text-sm">3. Reapresentação Multissensorial</strong>
              <span class="text-xs text-slate-300">A mesma palavra vista em áudio, em cena de série, na aula ao vivo e no desafio escrito.</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- OS 9 PILARES EM PROFUNDIDADE -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-white">
          Os 9 Pilares Passo a Passo
        </h2>
        <p class="text-slate-300 text-sm sm:text-base mt-2">
          Cada letra do acrônimo A.U.T.E.N.T.I.C.A representa um alicerce do seu desenvolvimento na plataforma.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {pillarsDetail.map((p) => (
          <div class="glass-card p-6 sm:p-7 rounded-2xl flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-blue-600 text-white flex items-center justify-center font-heading font-black text-2xl shadow-md mb-4">
                {p.letter}
              </div>
              <h3 class="text-xl font-heading font-bold text-white mb-1">
                {p.name}
              </h3>
              <p class="text-xs font-semibold text-indigo-400 mb-4">
                {p.lead}
              </p>
              <ul class="space-y-2.5 text-xs text-slate-300">
                {p.bullets.map((b) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-400 font-bold shrink-0">•</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-16 text-center">
        <a href="/planos" class="btn-primary !text-base !py-4 !px-8">
          Experimentar o Método na Prática por R$ 39,90/mês
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
