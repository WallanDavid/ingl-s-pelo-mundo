---
// src/pages/metodo.astro
// Metodologia A.U.T.E.N.T.I.C.A & Os 4Ps da Pronúncia
import BaseLayout from '../layouts/BaseLayout.astro';
import MethodAuthentic from '../components/MethodAuthentic.astro';
import InteractiveComparison from '../components/InteractiveComparison.astro';

const pageTitle = 'Metodologia A.U.T.E.N.T.I.C.A | Os 9 Pilares da Fluência';
const pageDesc = 'Conheça em detalhes a Metodologia Autêntica e os 4Ps da pronúncia criados pela Prof. Amanda Beatriz para destravar a fala sem medo.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/metodo"
>
  <!-- CABEÇALHO -->
  <section class="pt-16 pb-12 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff]">
        <span>Neurociência & Fonética</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-serif text-white tracking-tight leading-tight">
        A ciência por trás da sua <em class="italic font-normal text-[#c8c2ff]">fala espontânea.</em>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
        Elimine o bloqueio emocional, a tradução mental e a ansiedade através dos 4Ps e dos 9 pilares A.U.T.E.N.T.I.C.A.
      </p>
    </div>
  </section>

  <!-- SEÇÃO PRINCIPAL DO MÉTODO -->
  <MethodAuthentic />

  <!-- COMPARATIVO VISUAL -->
  <InteractiveComparison />

  <!-- CTA -->
  <section class="py-16 text-center border-t border-white/10 bg-[#05050a]">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h3 class="text-2xl sm:text-3xl font-serif text-white">
        Pronto para experimentar o Método Autêntico na prática?
      </h3>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/planos" class="btn-white-luxury px-8 py-3.5 text-xs uppercase tracking-wider shadow-lg">
          Ver Planos & Matricular
        </a>
        <a href="/#produtos" class="btn-ghost-cosmic px-6 py-3.5 text-xs uppercase tracking-wider">
          Explorar os 15 Produtos
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
