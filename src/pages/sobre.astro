---
// src/pages/sobre.astro
// Biografia e Autoridade da Prof. Amanda Beatriz
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Amanda Beatriz | Fundadora do Fluente no Mundo';
const pageDesc = 'Conheça a história de Amanda Beatriz: professora poliglota, pesquisadora da neurociência aplicada a idiomas e criadora da Metodologia Autêntica.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/sobre"
>
  
  <!-- CABEÇALHO -->
  <section class="pt-16 pb-12 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff]">
        <span>Mentora & Fundadora</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-serif text-white tracking-tight leading-tight">
        Prazer, eu sou a <em class="italic font-normal text-[#c8c2ff]">Amanda Beatriz.</em>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
        Professora poliglota de idiomas há mais de 5 anos, pesquisadora de neuroaprendizagem e criadora do movimento Fluente no Mundo.
      </p>
    </div>
  </section>

  <!-- BIOGRAFIA E FOTOS REAIS -->
  <section class="py-16 bg-[#070812] border-t border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Fotos Autênticas -->
        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-3xl overflow-hidden border border-white/15 shadow-2xl bg-[#0c0d1b] relative group">
            <img
              src="/images/about-me.png"
              alt="Professora Amanda Beatriz"
              class="w-full h-auto aspect-[3/4] object-cover object-top transition-transform duration-700 group-hover:scale-105"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#05050a] via-transparent to-transparent opacity-80"></div>
            
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-[#070812]/90 backdrop-blur border border-white/10 text-white">
              <strong class="font-serif text-base block font-bold">Amanda Beatriz</strong>
              <span class="text-xs text-[#c8c2ff] block">+10.000 aulas dadas · Hiperpoliglota em Construção</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <img src="/images/class-live.jpeg" alt="Aula com a Amanda" class="w-full h-32 object-cover rounded-2xl border border-white/10" />
            <img src="/images/cafe-com-plataforma.jpg" alt="Setup de Estudo" class="w-full h-32 object-cover rounded-2xl border border-white/10" />
          </div>
        </div>

        <!-- Texto de Apresentação -->
        <div class="lg:col-span-7 space-y-6 text-slate-300 text-sm sm:text-base leading-relaxed">
          
          <h2 class="text-2xl sm:text-3xl font-serif text-white leading-tight">
            "A vida é grande demais para caber em uma única categoria."
          </h2>

          <p>
            Alma mestre, professora poliglota de idiomas há mais de 5 anos, fundadora do Fluente no Mundo e criadora da Metodologia Autêntica. Uma mulher que se recusa a ser definida por uma única habilidade e vive para explorar e expressar todo o potencial que pulsa dentro de si.
          </p>

          <p>
            Durante anos, observei milhares de brasileiros inteligentes se sentirem incapazes de falar inglês por conta de um sistema educacional arcaico que ensina idiomas através de regras abstratas e punição do erro. Foi nesse caminho que criei um novo modelo de educação baseado em neurociência, acolhimento emocional e aculturamento da vida real.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 space-y-1">
              <strong class="text-white block font-serif text-lg">+10 Anos de Impacto</strong>
              <p class="text-xs text-slate-400">Uma década de estudo diário, leitura científica e pesquisa aplicada.</p>
            </div>
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 space-y-1">
              <strong class="text-[#c8c2ff] block font-serif text-lg">Comunidade Global</strong>
              <p class="text-xs text-slate-400">Alunos no Brasil e no exterior aprendendo juntos sem julgamentos.</p>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap gap-4">
            <a href="/planos" class="btn-white-luxury px-8 py-3.5 text-xs uppercase tracking-wider shadow-xl">
              Estudar com a Amanda
            </a>
            <a href="/metodo" class="btn-ghost-cosmic px-6 py-3.5 text-xs uppercase tracking-wider">
              Conhecer a Metodologia &rarr;
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

</BaseLayout>
