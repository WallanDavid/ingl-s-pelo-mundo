---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Formação Global | Trilhas de Aprendizagem e Cursos do Fluente no Mundo';
const pageDesc = 'Conheça as Formações Essenciais e Complementares da Formação Global. Cronogramas semanais e mensais organizados e certificados a cada 3 meses.';

const essentialCourses = [
  {
    title: 'Inglês Essencial: A Base Autêntica',
    badge: 'Formação Obrigatória',
    tag: 'Base do Método',
    desc: 'O alicerce fundamental para quem está começando do zero ou precisa reconstruir a base sem vícios e sem traumas. Estruturas-chave da língua inglesa ensinadas com clareza.',
    topics: ['Fonética e Padrões de Vogais', 'Estruturas de Comunicação Cotidiana', 'Eliminação da Tradução Mental', 'Primeiras Conversas com Confiança'],
    duration: 'Módulos trimestrais contínuos',
  },
  {
    title: 'Virando a Chave dos Estudos - Inglês',
    badge: 'Metacognição',
    tag: 'Método de Estudo',
    desc: 'O módulo que ensina como o seu cérebro aprende. Você descobre como organizar sua rotina diária em 20 minutos, usar o SRS e reter vocabulário para sempre.',
    topics: ['Neurociência da Memória', 'Rotina de Estudos Eficiente', 'Como Usar o Repetidor Espaçado', 'Gestão de Foco e Ansiedade'],
    duration: '4 semanas de alinhamento',
  },
  {
    title: 'Dominando a Arte da Pronúncia (4Ps)',
    badge: 'Pronúncia Real',
    tag: 'Mecânica Vocal',
    desc: 'Treinamento completo para destravar os padrões de sons nativos, linked words e pronúncia dos 4Ps, eliminando a vergonha de falar com sotaque travado.',
    topics: ['Sons de TH e Vogais Curtas', 'Connected Speech & Ritmo', 'Treinamento de Escuta e Fala', 'Gravações com Feedback'],
    duration: 'Trilha prática intensiva',
  },
];

const complementaryCourses = [
  {
    title: 'Welcome Traveler (Inglês para Viagens)',
    tag: 'Situações Reais',
    desc: 'Prepare-se para explorar o mundo com segurança: imigração, aeroportos, hotéis, restaurantes, compras, emergências e conversas com locais.',
  },
  {
    title: 'Linguagem, Comunicação e Expressão',
    tag: 'Comunicação Autêntica',
    desc: 'Desenvolva expressividade, linguagem corporal e capacidade de sustentar conversas sobre opiniões, sentimentos e projetos de vida.',
  },
  {
    title: 'Virando a Chave dos Estudos - Francês',
    tag: 'Jornada Poliglota',
    desc: 'Introdução fascinante à sonoridade e cultura francófona para alunos que desejam expandir seus horizontes linguísticos como hobby.',
  },
  {
    title: 'Aulas da Jornada Poliglota',
    tag: 'Multicultural',
    desc: 'Workshops e aulas especiais de aculturamento cobrindo idiomas como Espanhol, Italiano, Mandarim, Alemão e Japonês.',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/formacao-global"
>
  
  <!-- CABEÇALHO DA PÁGINA -->
  <section class="py-16 sm:py-20 relative border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>📚 Estrutura Pedagógica Completa</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-heading font-black text-white tracking-tight leading-tight">
        A Formação <span class="gradient-text-indigo">Global</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Todas as aulas organizadas em um <strong>cronograma semanal e mensal unificado</strong> com metas diárias. Você nunca mais fica em dúvida sobre o que estudar hoje.
      </p>
    </div>
  </section>

  <!-- FORMAÇÕES ESSENCIAIS (A BASE) -->
  <section class="py-16 bg-[#070b16]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase mb-2">
          ⭐ Matrículas Obrigatórias
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white">
          Formações Essenciais
        </h2>
        <p class="text-slate-300 text-sm mt-1 max-w-2xl">
          A base sólida do método para você caminhar com máxima segurança. Todos os alunos devem iniciar por aqui para construir os fundamentos fonéticos e conceituais corretos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {essentialCourses.map((c) => (
          <div class="glass-card p-6 rounded-2xl flex flex-col justify-between border-t-4 border-t-indigo-500">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-bold text-indigo-300 bg-indigo-500/20 px-2.5 py-0.5 rounded-full">
                  {c.badge}
                </span>
                <span class="text-xs text-slate-400">{c.duration}</span>
              </div>
              <h3 class="text-xl font-heading font-bold text-white mb-2">
                {c.title}
              </h3>
              <p class="text-xs text-slate-300 mb-6 leading-relaxed">
                {c.desc}
              </p>

              <div class="border-t border-white/5 pt-4">
                <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-2">
                  Tópicos Trabalhados:
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300">
                  {c.topics.map((t) => (
                    <li class="flex items-center gap-2">
                      <span class="text-emerald-400">✓</span>
                      <span>{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- FORMAÇÕES COMPLEMENTARES -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 text-teal-400 text-xs font-bold uppercase mb-2">
          🚀 Expansão de Repertório
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white">
          Formações Complementares
        </h2>
        <p class="text-slate-300 text-sm mt-1 max-w-2xl">
          Explore livremente conforme seus objetivos e interesses pessoais. Todas disponíveis com acesso livre para os alunos da plataforma.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {complementaryCourses.map((c) => (
          <div class="glass-card p-5 rounded-2xl flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-bold text-teal-300 bg-teal-500/20 px-2.5 py-0.5 rounded-full inline-block mb-3">
                {c.tag}
              </span>
              <h3 class="text-base font-heading font-bold text-white mb-2">
                {c.title}
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                {c.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- O SISTEMA DE CERTIFICADOS TRIMESTRAIS -->
  <section class="py-16 bg-gradient-to-r from-indigo-950/40 via-[#0a0e1a] to-slate-900/60 border-t border-white/5">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 sm:p-12 rounded-3xl border border-white/10 text-center">
        <span class="text-4xl mb-4 inline-block">🏆</span>
        <h2 class="text-3xl font-heading font-black text-white">
          Certificação Modular a Cada 3 Meses
        </h2>
        <p class="mt-4 text-slate-300 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">
          Sua jornada em cada formação é dividida em <strong>mini módulos de 3 meses</strong>. Ao final de cada ciclo, você recebe um certificado reconhecido pela Metodologia Autêntica — comprovando seu esforço, sua constância e a carga horária dedicada.
        </p>
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto text-xs text-slate-300">
          <div class="p-3 rounded-xl bg-white/5 border border-white/5">
            <strong>1. Aulas Gravadas e Ao Vivo</strong>
            <p class="text-slate-400 mt-1">Conclua o cronograma semanal</p>
          </div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/5">
            <strong>2. Desafios & Correções</strong>
            <p class="text-slate-400 mt-1">Envie suas atividades e áudios</p>
          </div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/5">
            <strong>3. Avaliação Prática</strong>
            <p class="text-slate-400 mt-1">Valide seu progresso real</p>
          </div>
        </div>

        <div class="mt-10">
          <a href="/planos" class="btn-primary !py-3.5 !px-8 text-sm">
            Garantir Minha Vaga na Formação Global
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
