---
// src/pages/plataforma.astro
// Apresentação da Plataforma Oficial dos Alunos — Fluente no Mundo
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformSimulator from '../components/PlatformSimulator.astro';
import OfficialPricing from '../components/OfficialPricing.astro';

const pageTitle = 'Plataforma dos Alunos & 15 Produtos | Fluente no Mundo';
const pageDesc = 'Explore por dentro a plataforma dos alunos: Formação Global, Método A.U.T.E.N.T.I.C.A, Jornada Poliglota, Imersão com a Prof e mais.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/plataforma"
>
  
  <!-- CABEÇALHO -->
  <section class="pt-16 pb-12 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-[#9b8fff]">
        <span>Área do Aluno · 15 Módulos Integrados</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-serif text-white tracking-tight leading-tight">
        Conheça a plataforma <em class="italic font-normal text-[#c8c2ff]">por dentro.</em>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
        Tudo o que você precisa para alcançar a fluência real reunido em uma experiência moderna de estudos.
      </p>
      
      <div class="pt-2 flex flex-wrap justify-center gap-4">
        <a href="#planos" class="btn-white-luxury px-8 py-3.5 text-xs uppercase tracking-wider shadow-lg">
          Matricular por R$ 39,90/mês
        </a>
        <a 
          href="https://alunos.fluentenomundo.com/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-ghost-cosmic px-6 py-3.5 text-xs uppercase tracking-wider flex items-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Acessar Login Oficial</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SIMULADOR DA PLATAFORMA REAL -->
  <PlatformSimulator />

  <!-- PLANOS OFICIAIS -->
  <OfficialPricing />

</BaseLayout>
