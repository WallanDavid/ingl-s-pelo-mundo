---
// src/pages/plataforma.astro
// Apresentação Comercial do Ecossistema de Produtos — Fluente no Mundo
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductsCatalog from '../components/ProductsCatalog.astro';
import PricingCard from '../components/PricingCard.astro';

const pageTitle = 'Os 15 Produtos & Módulos | Fluente no Mundo';
const pageDesc = 'Conheça em detalhes os 15 produtos pedagógicos inclusos na matrícula do Fluente no Mundo: Formação Global, Método A.U.T.E.N.T.I.C.A, Jornada Poliglota, Imersão ao Vivo, Sua Biblioteca e acompanhamento direto.';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/plataforma"
>
  
  <!-- CABEÇALHO DA PÁGINA COMERCIAL -->
  <section class="pt-16 pb-16 bg-[#06060c] border-b border-white/5 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold uppercase tracking-widest text-[#9b8fff] mb-4">
        <span>Catálogo Oficial</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-serif text-white tracking-tight leading-tight mt-2">
        O Ecossistema Completo de <em class="italic font-normal text-[#c8c2ff]">Produtos & Módulos</em>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Tudo o que você precisa para destravar sua fala e alcançar autonomia em idiomas, reunido em uma única assinatura sem custos adicionais por módulo.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#planos"
          class="px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-white text-slate-950 hover:bg-slate-100 transition-all shadow-lg"
        >
          <span>Quero Me Matricular Agora</span>
        </a>
        <a
          href="https://alunos.fluentenomundo.com"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-full text-xs font-semibold bg-white/5 border border-white/15 text-white hover:bg-white/10 transition-all flex items-center justify-center gap-2"
        >
          <span>Login de Alunos</span>
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CATÁLOGO DOS 15 PRODUTOS -->
  <ProductsCatalog />

  <!-- PLANOS E VALORES -->
  <PricingCard />

</BaseLayout>
