---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Imersão com a Prof | Aulas ao Vivo e Masterclasses Semanais';
const pageDesc = 'Aulas de inglês ao vivo toda quarta-feira com a Prof. Amanda Beatriz. Acesso a masterclasses exclusivas, podcasts culturais e acervo completo de gravações.';

const masterclassesExamples = [
  {
    title: 'O Grande Início do Sonho! O Convite a Você',
    date: 'Aula Inaugural',
    duration: '20 min',
    desc: 'O ponto de partida da sua transformação: alinhamento de mentalidade, organização da rotina e desbloqueio do medo de errar.',
  },
  {
    title: 'A Chave Disponível para Você Aprender',
    date: 'Aula Magna',
    duration: '45 min',
    desc: 'Como funciona a neuroplasticidade na aquisição de uma nova língua e como ativar a atenção seletiva nos seus estudos.',
  },
  {
    title: 'Descomplicando o Tal do "Verb To Be"',
    date: 'Masterclass Fonética',
    duration: '50 min',
    desc: 'Aprenda o verbo to be como os nativos realmente usam na fala rápida, sem tabelas de gramática maçantes e com prática oral.',
  },
  {
    title: 'Uma Nova Era dos Estudos: Imersão Ativa',
    date: 'Workshop Estratégico',
    duration: '60 min',
    desc: 'Estratégias de escuta contextual com podcasts reais e roteiro de estudo audiovisual para acelerar sua compreensão.',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/imersao"
>
  
  <!-- CABEÇALHO DA PÁGINA -->
  <section class="pt-12 pb-16 bg-[#f8fafc] border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="badge-subtle mb-4">Ao Vivo com a Professora</span>
      <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-slate-900 tracking-tight leading-tight">
        Imersão com a Prof. Amanda
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
        Toda <strong>quarta-feira</strong> temos um encontro ao vivo e exclusivo para destravar pontos críticos da língua, praticar pronúncia e tirar dúvidas em tempo real.
      </p>
    </div>
  </section>

  <!-- COMO FUNCIONAM AS AULAS AO VIVO -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">

        <div class="editorial-card p-6 flex flex-col justify-between border-t-4 border-t-blue-700">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 text-blue-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="text-xl font-heading font-bold text-slate-900 mb-2">Toda Quarta-Feira</h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              Encontro semanal marcado no calendário da plataforma. Um momento de foco compartilhado com a professora e com a comunidade de alunos.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100">
            <span class="text-xs font-mono font-semibold text-blue-700">Toda Quarta · 20h (horário de Brasília)</span>
          </div>
        </div>

        <div class="editorial-card p-6 flex flex-col justify-between border-t-4 border-t-emerald-600">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h2 class="text-xl font-heading font-bold text-slate-900 mb-2">Treinamento Prático</h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              Nada de aulas teóricas de slide chato. A professora interage, conduz dinâmicas de repetição, explica nuances fonéticas e corrige equívocos comuns.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100">
            <span class="text-xs font-mono font-semibold text-emerald-700">Foco em Fala e Pronúncia</span>
          </div>
        </div>

        <div class="editorial-card p-6 flex flex-col justify-between border-t-4 border-t-amber-500">
          <div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.882v6.236a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="text-xl font-heading font-bold text-slate-900 mb-2">Gravação Disponível</h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              Não conseguiu assistir no horário? Não se preocupe: a gravação integral em alta definição fica salva na plataforma para você assistir no seu tempo.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100">
            <span class="text-xs font-mono font-semibold text-amber-700">Acervo completo disponível</span>
          </div>
        </div>

      </div>

      <!-- EXEMPLOS DE MASTERCLASSES GRAVADAS NO ACERVO -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="badge-neutral mb-3">Acervo Histórico</span>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 mt-3">
          Masterclasses Disponíveis no Acervo
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
          Ao se matricular, você tem acesso imediato não apenas às próximas aulas, mas a todo o acervo já produzido.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {masterclassesExamples.map((m) => (
          <div class="editorial-card p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3 text-xs text-slate-500">
                <span class="px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200 font-semibold text-blue-700">
                  {m.date}
                </span>
                <span class="font-mono text-slate-400">{m.duration}</span>
              </div>
              <h3 class="text-lg font-heading font-bold text-slate-900 mb-2">
                {m.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {m.desc}
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-medium">Disponível na Área do Aluno</span>
              <span class="text-blue-700 font-bold">Acesso dos Matriculados</span>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a href="/planos" class="btn-editorial-primary !py-3.5 !px-8 text-sm">
          Garantir Acesso às Aulas ao Vivo por R$ 39,90/mês
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
