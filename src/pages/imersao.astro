---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Imersão com a Prof | Aulas ao Vivo e Masterclasses Semanais';
const pageDesc = 'Aulas de inglês ao vivo toda quarta-feira com a Prof. Amanda Beatriz. Acesso a masterclasses exclusivas, podcasts culturais e acervo completo de gravações.';

const masterclassesExamples = [
  {
    title: 'O Grande Início do Sonho! O Convite a Você',
    date: 'Aula Inaugural',
    duration: '20 min',
    desc: 'O ponto de partida da sua transformação: alinhamento de mentalidade, organização da rotina e desbloqueio do medo de errar.',
  },
  {
    title: 'A Chave Disponível para Você Aprender',
    date: 'Aula Magna',
    duration: '45 min',
    desc: 'Como funciona a neuroplasticidade na aquisição de uma nova língua e como ativar a atenção seletiva nos seus estudos.',
  },
  {
    title: 'Descomplicando o Tal do "Verb To Be"',
    date: 'Masterclass Fonética',
    duration: '50 min',
    desc: 'Aprenda o verbo to be como os nativos realmente usam na fala rápida, sem tabelas de gramática maçantes e com prática oral.',
  },
  {
    title: 'Uma Nova Era dos Estudos: Imersão Ativa',
    date: 'Workshop Estratégico',
    duration: '60 min',
    desc: 'Estratégias de escuta contextual com podcasts reais e roteiro de estudo audiovisual para acelerar sua compreensão.',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl="https://fluentenomundo.com/imersao"
>
  
  <!-- CABEÇALHO DA PÁGINA -->
  <section class="py-16 sm:py-20 relative border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>🔴 Ao Vivo com a Professora</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-heading font-black text-white tracking-tight leading-tight">
        Imersão com a <span class="gradient-text-indigo">Prof. Amanda</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Toda <strong>quarta-feira</strong> temos um encontro ao vivo e exclusivo para destravar pontos críticos da língua, praticar pronúncia e tirar dúvidas em tempo real.
      </p>
    </div>
  </section>

  <!-- COMO FUNCIONAM AS AULAS AO VIVO -->
  <section class="py-16 bg-[#070b16]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
        <div class="glass-card p-6 rounded-2xl flex flex-col justify-between border-t-4 border-t-indigo-500">
          <div>
            <span class="text-3xl mb-3 block">🗓️</span>
            <h2 class="text-xl font-heading font-bold text-white mb-2">Toda Quarta-Feira</h2>
            <p class="text-xs text-slate-300 leading-relaxed">
              Encontro semanal marcado no calendário da plataforma. Um momento de foco compartilhado com a professora e com a comunidade de alunos.
            </p>
          </div>
        </div>

        <div class="glass-card p-6 rounded-2xl flex flex-col justify-between border-t-4 border-t-teal-500">
          <div>
            <span class="text-3xl mb-3 block">🎙️</span>
            <h2 class="text-xl font-heading font-bold text-white mb-2">Treinamento Prático</h2>
            <p class="text-xs text-slate-300 leading-relaxed">
              Nada de aulas teóricas de slide chato. A professora interage, conduz dinâmicas de repetição, explica nuances fonéticas e corrige equívocos comuns.
            </p>
          </div>
        </div>

        <div class="glass-card p-6 rounded-2xl flex flex-col justify-between border-t-4 border-t-amber-500">
          <div>
            <span class="text-3xl mb-3 block">📼</span>
            <h2 class="text-xl font-heading font-bold text-white mb-2">Gravação Disponível</h2>
            <p class="text-xs text-slate-300 leading-relaxed">
              Não conseguiu assistir no horário? Não se preocupe: a gravação integral em alta definição fica salva na plataforma para você assistir no seu tempo.
            </p>
          </div>
        </div>
      </div>

      <!-- EXEMPLOS DE MASTERCLASSES GRAVADAS NO ACERVO -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white">
          Acervo Histórico de Masterclasses
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-2">
          Ao se matricular, você tem acesso imediato não apenas às próximas aulas, mas a todo o acervo já produzido.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {masterclassesExamples.map((m) => (
          <div class="glass-card p-6 rounded-2xl flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3 text-xs text-slate-400">
                <span class="px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 font-semibold text-indigo-300">
                  {m.date}
                </span>
                <span>⏱ {m.duration}</span>
              </div>
              <h3 class="text-lg font-heading font-bold text-white mb-2">
                {m.title}
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                {m.desc}
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-indigo-400 font-semibold">
              <span>Disponível na Área do Aluno</span>
              <span>🔒 Acesso dos Matriculados</span>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a href="/planos" class="btn-primary !py-4 !px-8 text-sm">
          Garantir Acesso às Aulas ao Vivo por R$ 39,90/mês
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
