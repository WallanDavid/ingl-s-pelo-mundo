---
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  structuredData?: any;
}

const { title, description, canonicalUrl, ogImage, structuredData } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      structuredData={structuredData}
    />
  </head>
  <body class="flex flex-col min-h-screen text-slate-100 antialiased selection:bg-[#9b8fff] selection:text-black bg-[#05050a] relative">
    <!-- Star Canvas / Ambient Cosmic Glow Background -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="cosmic-glow w-[600px] h-[600px] -top-40 -left-40 bg-[#6c5fff]"></div>
      <div class="cosmic-glow w-[800px] h-[800px] top-1/3 -right-60 bg-[#9b8fff]"></div>
      <div class="cosmic-glow w-[700px] h-[700px] bottom-10 left-1/4 bg-[#4f46e5]"></div>
      <div class="absolute inset-0 cosmic-grid opacity-60"></div>
    </div>

    <!-- Header Global Fixo -->
    <Header />

    <!-- Conteúdo Principal da Página -->
    <main class="flex-grow relative z-10">
      <slot />
    </main>

    <!-- Rodapé Global -->
    <Footer />
  </body>
</html>
